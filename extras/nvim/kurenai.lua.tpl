-- KURENAI colorscheme for Neovim. Generated by `kurenai-ctl theme`: it is overwritten, do not edit.
-- Use it with:  vim.cmd.colorscheme("kurenai")   (colours follow the wallpaper while this scheme is active)
-- The editor background is transparent by default so it matches a translucent terminal.
-- For a solid background put  vim.g.kurenai_transparent = false  in your init.lua BEFORE the colorscheme line.
vim.cmd("highlight clear")
if vim.fn.exists("syntax_on") == 1 then vim.cmd("syntax reset") end
vim.o.termguicolors = true
vim.g.colors_name = "kurenai"

local c = {
  bg = "{{bg}}", surface = "{{surface}}", raised = "{{raised}}",
  text = "{{text}}", text2 = "{{text2}}", muted = "{{muted}}",
  accent = "{{accent}}", accent_text = "{{accentText}}", ink = "{{inkOnAccent}}",
  teal = "{{teal}}", rose = "{{rose}}", amber = "{{amber}}",
  red = "{{ansi_red}}", green = "{{ansi_green}}", yellow = "{{ansi_yellow}}", blue = "{{ansi_blue}}",
  magenta = "{{ansi_magenta}}", cyan = "{{ansi_cyan}}",
}
local transparent = vim.g.kurenai_transparent ~= false
local base_bg = transparent and "NONE" or c.bg

local function hl(name, spec) vim.api.nvim_set_hl(0, name, spec) end

-- editor
hl("Normal",       { fg = c.text, bg = base_bg })
hl("NormalNC",     { fg = c.text, bg = base_bg })
hl("NormalFloat",  { fg = c.text, bg = c.surface })
hl("FloatBorder",  { fg = c.muted, bg = c.surface })
hl("FloatTitle",   { fg = c.accent_text, bg = c.surface, bold = true })
hl("Cursor",       { fg = c.bg, bg = c.accent_text })
hl("CursorLine",   { bg = c.surface })
hl("CursorColumn", { bg = c.surface })
hl("ColorColumn",  { bg = c.surface })
hl("LineNr",       { fg = c.muted })
hl("CursorLineNr", { fg = c.accent_text, bold = true })
hl("SignColumn",   { fg = c.muted, bg = base_bg })
hl("FoldColumn",   { fg = c.muted, bg = base_bg })
hl("Folded",       { fg = c.text2, bg = c.surface })
hl("VertSplit",    { fg = c.raised })
hl("WinSeparator", { fg = c.raised })
hl("EndOfBuffer",  { fg = c.raised })
hl("NonText",      { fg = c.raised })
hl("Whitespace",   { fg = c.raised })
hl("SpecialKey",   { fg = c.raised })
hl("Visual",       { bg = c.raised })
hl("VisualNOS",    { bg = c.raised })
hl("Search",       { fg = c.bg, bg = c.amber })
hl("IncSearch",    { fg = c.ink, bg = c.accent })
hl("CurSearch",    { fg = c.ink, bg = c.accent })
hl("MatchParen",   { fg = c.accent_text, bold = true, underline = true })
hl("Directory",    { fg = c.teal })
hl("Title",        { fg = c.accent_text, bold = true })
hl("ErrorMsg",     { fg = c.red, bold = true })
hl("WarningMsg",   { fg = c.amber })
hl("ModeMsg",      { fg = c.accent_text, bold = true })
hl("MoreMsg",      { fg = c.green })
hl("Question",     { fg = c.teal })
hl("WildMenu",     { fg = c.ink, bg = c.accent })
hl("Conceal",      { fg = c.muted })
hl("QuickFixLine", { bg = c.raised })

-- menus, statusline, tabs
hl("Pmenu",        { fg = c.text, bg = c.surface })
hl("PmenuSel",     { fg = c.ink, bg = c.accent })
hl("PmenuSbar",    { bg = c.raised })
hl("PmenuThumb",   { bg = c.muted })
hl("StatusLine",   { fg = c.text, bg = c.surface })
hl("StatusLineNC", { fg = c.muted, bg = c.surface })
hl("TabLine",      { fg = c.text2, bg = c.surface })
hl("TabLineSel",   { fg = c.ink, bg = c.accent, bold = true })
hl("TabLineFill",  { bg = c.surface })
hl("WinBar",       { fg = c.text2 })
hl("WinBarNC",     { fg = c.muted })

-- syntax
hl("Comment",      { fg = c.muted, italic = true })
hl("Constant",     { fg = c.rose })
hl("String",       { fg = c.green })
hl("Character",    { fg = c.green })
hl("Number",       { fg = c.amber })
hl("Boolean",      { fg = c.amber })
hl("Float",        { fg = c.amber })
hl("Identifier",   { fg = c.text })
hl("Function",     { fg = c.teal })
hl("Statement",    { fg = c.accent_text })
hl("Conditional",  { fg = c.accent_text })
hl("Repeat",       { fg = c.accent_text })
hl("Label",        { fg = c.accent_text })
hl("Operator",     { fg = c.text2 })
hl("Keyword",      { fg = c.accent_text })
hl("Exception",    { fg = c.red })
hl("PreProc",      { fg = c.magenta })
hl("Include",      { fg = c.magenta })
hl("Define",       { fg = c.magenta })
hl("Macro",        { fg = c.magenta })
hl("Type",         { fg = c.yellow })
hl("StorageClass", { fg = c.yellow })
hl("Structure",    { fg = c.yellow })
hl("Typedef",      { fg = c.yellow })
hl("Special",      { fg = c.cyan })
hl("SpecialChar",  { fg = c.cyan })
hl("Delimiter",    { fg = c.text2 })
hl("Tag",          { fg = c.cyan })
hl("Underlined",   { fg = c.blue, underline = true })
hl("Todo",         { fg = c.bg, bg = c.amber, bold = true })
hl("Error",        { fg = c.red })

-- tree-sitter and LSP semantic groups that need more than the defaults
hl("@variable",          { fg = c.text })
hl("@variable.builtin",  { fg = c.rose, italic = true })
hl("@parameter",         { fg = c.text2 })
hl("@property",          { fg = c.cyan })
hl("@field",             { fg = c.cyan })
hl("@constructor",       { fg = c.yellow })
hl("@tag",               { fg = c.accent_text })
hl("@tag.attribute",     { fg = c.yellow })
hl("@tag.delimiter",     { fg = c.text2 })
hl("@punctuation",       { fg = c.text2 })
hl("@markup.heading",    { fg = c.accent_text, bold = true })
hl("@markup.link",       { fg = c.blue, underline = true })
hl("@markup.strong",     { bold = true })
hl("@markup.italic",     { italic = true })

-- diagnostics, diffs, git signs
hl("DiagnosticError",    { fg = c.red })
hl("DiagnosticWarn",     { fg = c.amber })
hl("DiagnosticInfo",     { fg = c.blue })
hl("DiagnosticHint",     { fg = c.teal })
hl("DiagnosticOk",       { fg = c.green })
hl("DiagnosticUnderlineError", { undercurl = true, sp = c.red })
hl("DiagnosticUnderlineWarn",  { undercurl = true, sp = c.amber })
hl("DiagnosticUnderlineInfo",  { undercurl = true, sp = c.blue })
hl("DiagnosticUnderlineHint",  { undercurl = true, sp = c.teal })
hl("DiffAdd",     { bg = c.surface, fg = c.green })
hl("DiffChange",  { bg = c.surface, fg = c.amber })
hl("DiffDelete",  { bg = c.surface, fg = c.red })
hl("DiffText",    { bg = c.raised, fg = c.amber, bold = true })
hl("Added",       { fg = c.green })
hl("Changed",     { fg = c.amber })
hl("Removed",     { fg = c.red })
hl("GitSignsAdd",    { fg = c.green })
hl("GitSignsChange", { fg = c.amber })
hl("GitSignsDelete", { fg = c.red })
hl("SpellBad",   { undercurl = true, sp = c.red })
hl("SpellCap",   { undercurl = true, sp = c.amber })
hl("SpellLocal", { undercurl = true, sp = c.blue })
hl("SpellRare",  { undercurl = true, sp = c.teal })

vim.g.terminal_color_0  = c.surface;  vim.g.terminal_color_8  = c.muted
vim.g.terminal_color_1  = c.red;      vim.g.terminal_color_9  = c.red
vim.g.terminal_color_2  = c.green;    vim.g.terminal_color_10 = c.green
vim.g.terminal_color_3  = c.yellow;   vim.g.terminal_color_11 = c.yellow
vim.g.terminal_color_4  = c.blue;     vim.g.terminal_color_12 = c.blue
vim.g.terminal_color_5  = c.magenta;  vim.g.terminal_color_13 = c.magenta
vim.g.terminal_color_6  = c.cyan;     vim.g.terminal_color_14 = c.cyan
vim.g.terminal_color_7  = c.text2;    vim.g.terminal_color_15 = c.text
