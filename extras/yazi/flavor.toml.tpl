# KURENAI flavor for yazi. Generated by `kurenai-ctl theme`: it is overwritten, do not edit.
[mgr]
cwd            = { fg = "{{teal}}" }
find_keyword   = { fg = "{{amber}}", bold = true }
find_position  = { fg = "{{rose}}", bold = true }
symlink_target = { fg = "{{rose}}", italic = true }
marker_copied  = { fg = "{{ansi_green}}", bg = "{{ansi_green}}" }
marker_cut     = { fg = "{{ansi_red}}", bg = "{{ansi_red}}" }
marker_marked  = { fg = "{{teal}}", bg = "{{teal}}" }
marker_selected = { fg = "{{accentText}}", bg = "{{accentText}}" }
count_copied   = { fg = "{{bg}}", bg = "{{ansi_green}}" }
count_cut      = { fg = "{{bg}}", bg = "{{ansi_red}}" }
count_selected = { fg = "{{inkOnAccent}}", bg = "{{accent}}" }
border_style   = { fg = "{{muted}}" }

[tabs]
active   = { fg = "{{inkOnAccent}}", bg = "{{accent}}", bold = true }
inactive = { fg = "{{text2}}", bg = "{{surface}}" }

[mode]
normal_main = { fg = "{{inkOnAccent}}", bg = "{{accent}}", bold = true }
normal_alt  = { fg = "{{accentText}}", bg = "{{surface}}" }
select_main = { fg = "{{bg}}", bg = "{{ansi_green}}", bold = true }
select_alt  = { fg = "{{ansi_green}}", bg = "{{surface}}" }
unset_main  = { fg = "{{bg}}", bg = "{{ansi_red}}", bold = true }
unset_alt   = { fg = "{{ansi_red}}", bg = "{{surface}}" }

[status]
overall         = { fg = "{{text}}", bg = "{{surface}}" }
perm_type       = { fg = "{{teal}}" }
perm_read       = { fg = "{{amber}}" }
perm_write      = { fg = "{{ansi_red}}" }
perm_exec       = { fg = "{{ansi_green}}" }
perm_sep        = { fg = "{{muted}}" }
progress_label  = { fg = "{{text}}", bold = true }
progress_normal = { fg = "{{accent}}", bg = "{{raised}}" }
progress_error  = { fg = "{{ansi_red}}", bg = "{{raised}}" }

[filetype]
rules = [
  { url = "*/", fg = "{{teal}}" },
  { mime = "image/*", fg = "{{amber}}" },
  { mime = "video/*", fg = "{{rose}}" },
  { mime = "audio/*", fg = "{{rose}}" },
  { mime = "application/zip", fg = "{{accentText}}" },
  { mime = "application/gzip", fg = "{{accentText}}" },
  { mime = "application/x-tar", fg = "{{accentText}}" },
  { mime = "application/pdf", fg = "{{ansi_red_b}}" },
  { url = "*", is = "orphan", fg = "{{ansi_red}}" },
  { url = "*", is = "exec", fg = "{{ansi_green}}" },
  { url = "*", fg = "{{text}}" },
]
