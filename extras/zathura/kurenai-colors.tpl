# KURENAI colours for zathura. Generated by `kurenai-ctl theme`: it is overwritten, do not edit.
# Applies to zathura windows opened after the change.
set default-bg              "{{bg}}"
set default-fg              "{{text}}"
set statusbar-bg            "{{surface}}"
set statusbar-fg            "{{text}}"
set inputbar-bg             "{{surface}}"
set inputbar-fg             "{{accentText}}"
set notification-bg         "{{raised}}"
set notification-fg         "{{text}}"
set notification-error-bg   "{{ansi_red}}"
set notification-error-fg   "{{bg}}"
set notification-warning-bg "{{amber}}"
set notification-warning-fg "{{bg}}"
set completion-bg           "{{surface}}"
set completion-fg           "{{text}}"
set completion-group-bg     "{{bg}}"
set completion-group-fg     "{{text2}}"
set completion-highlight-bg "{{accent}}"
set completion-highlight-fg "{{inkOnAccent}}"
set index-bg                "{{surface}}"
set index-fg                "{{text}}"
set index-active-bg         "{{accent}}"
set index-active-fg         "{{inkOnAccent}}"
set highlight-color         "{{accentText}}"
set highlight-fg            "{{accentText}}"
set highlight-active-color  "{{teal}}"
set recolor-lightcolor      "{{bg}}"
set recolor-darkcolor       "{{text}}"
set render-loading-bg       "{{bg}}"
set render-loading-fg       "{{text}}"
