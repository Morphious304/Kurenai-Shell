# KURENAI colours for Pacsea. Generated by `kurenai-ctl theme`: it is overwritten, do not edit.
# Your own theme.conf was saved first; `kurenai-ctl theme extra pacsea off` puts it back exactly as it was.
# Pacsea reads this file at start; in a running Pacsea press Ctrl+R to reload the colours.
# Format: key = #RRGGBB   (16 roles, see the Pacsea wiki: Configuration)

# Backgrounds (base = main area, mantle = panels, crust = deepest)
background_base = {{bg}}
background_mantle = {{darken(bg,0.2)}}
background_crust = {{darken(bg,0.4)}}

# Surfaces (selected rows, popups)
surface_level1 = {{surface}}
surface_level2 = {{raised}}

# Borders and separators
overlay_primary = {{mix(raised,text,0.3)}}
overlay_secondary = {{mix(raised,text,0.5)}}

# Text
text_primary = {{text}}
text_secondary = {{text2}}
text_tertiary = {{mix(text2,muted,0.5)}}

# Accents: interactive = teal, headings = the wallpaper accent, emphasis = rose
accent_interactive = {{teal}}
accent_heading = {{accentText}}
accent_emphasis = {{rose}}

# Status colours
semantic_success = {{ansi_green}}
semantic_warning = {{amber}}
semantic_error = {{ansi_red}}
