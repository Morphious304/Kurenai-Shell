# KURENAI colours for lazygit (gui.theme). Generated by `kurenai-ctl theme`: it is overwritten, do not edit.
gui:
  theme:
    activeBorderColor:
      - '{{accentText}}'
      - bold
    inactiveBorderColor:
      - '{{mix(raised,text,0.3)}}'
    searchingActiveBorderColor:
      - '{{teal}}'
      - bold
    optionsTextColor:
      - '{{teal}}'
    selectedLineBgColor:
      - '{{raised}}'
    cherryPickedCommitFgColor:
      - '{{teal}}'
    cherryPickedCommitBgColor:
      - '{{surface}}'
    markedBaseCommitFgColor:
      - '{{rose}}'
    markedBaseCommitBgColor:
      - '{{surface}}'
    unstagedChangesColor:
      - '{{ansi_red}}'
