#!/usr/bin/env bash
# kurenai-ctl: backup / enable / disable / validate helper for the KURENAI theme.
# Touches only: ~/.config/hypr/hyprland.lua (one marked line), ~/.config/hypr/kurenai.lua,
# ~/.config/quickshell/kurenai/, and ~/.local/share/kurenai/.
set -u

CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
HYPR_DIR="$CFG/hypr"
QS_DIR="$CFG/quickshell"
STATE="${XDG_DATA_HOME:-$HOME/.local/share}/kurenai"
BACKUPS="$STATE/backups"
MARK="KURENAI-HOOK"
HOOK='local ok_k, err_k = pcall(require, "kurenai"); if not ok_k then print("[kurenai] " .. tostring(err_k)) end -- KURENAI-HOOK'

die() { printf 'kurenai-ctl: %s\n' "$*" >&2; exit 1; }
stamp() { date +%Y%m%d-%H%M%S; }

usage() {
  cat <<EOF
Usage: kurenai-ctl <command>

  backup     copy ~/.config/hypr and ~/.config/quickshell into $BACKUPS/<timestamp>
  enable     backup, then append ONE marked line to hyprland.lua and reload Hyprland
  disable    remove that marked line (your other edits are kept) and reload
  validate   read-only health check of versions, services, fonts and files
  stop       stop the KURENAI shell if it is running
  rollback   stop shell + disable hook + move KURENAI files aside (nothing is deleted)
  restore    like rollback, and also restore hyprland.lua from the latest backup
EOF
}

cmd_backup() {
  local dir; dir="$BACKUPS/$(stamp)"
  mkdir -p "$dir" || die "cannot create $dir"
  [ -d "$HYPR_DIR" ] && cp -a "$HYPR_DIR" "$dir/hypr"
  [ -d "$QS_DIR" ]   && cp -a "$QS_DIR"   "$dir/quickshell"
  ln -sfn "$dir" "$BACKUPS/latest"
  echo "Backup written to $dir"
}

cmd_enable() {
  local f="$HYPR_DIR/hyprland.lua"
  [ -f "$f" ] || die "$f not found (this theme targets the Lua config)"
  [ -f "$HYPR_DIR/kurenai.lua" ] || die "kurenai.lua is not installed; run install.sh first"
  if grep -qF "$MARK" "$f"; then echo "Already enabled."; return 0; fi
  cmd_backup >/dev/null || die "backup failed; not touching hyprland.lua"
  printf '\n%s\n' "$HOOK" >> "$f"
  command -v hyprctl >/dev/null && hyprctl reload >/dev/null 2>&1
  echo "Enabled. Hyprland config errors (empty = none):"
  command -v hyprctl >/dev/null && hyprctl configerrors
}

cmd_disable() {
  local f="$HYPR_DIR/hyprland.lua"
  [ -f "$f" ] || return 0
  if grep -qF "$MARK" "$f"; then
    cp -a "$f" "$f.pre-disable-$(stamp)"
    sed -i "/$MARK/d" "$f"
    echo "Hook removed from hyprland.lua (copy kept as hyprland.lua.pre-disable-*)."
  else
    echo "No KURENAI hook found in hyprland.lua."
  fi
  command -v hyprctl >/dev/null && hyprctl reload >/dev/null 2>&1
}

cmd_stop() {
  if command -v qs >/dev/null 2>&1 && qs kill -c kurenai >/dev/null 2>&1; then
    echo "KURENAI shell stopped."
  elif pkill -f 'qs -c kurenai' 2>/dev/null || pkill -f 'quickshell -c kurenai' 2>/dev/null; then
    echo "KURENAI shell stopped."
  else
    echo "KURENAI shell was not running."
  fi
}

move_aside() {
  local dest="$STATE/removed-$(stamp)"
  mkdir -p "$dest"
  [ -e "$HYPR_DIR/kurenai.lua" ] && mv "$HYPR_DIR/kurenai.lua" "$dest/"
  [ -d "$QS_DIR/kurenai" ]       && mv "$QS_DIR/kurenai" "$dest/quickshell-kurenai"
  echo "KURENAI files moved to $dest"
}

cmd_rollback() {
  cmd_stop
  cmd_disable
  move_aside
  command -v hyprctl >/dev/null && hyprctl reload >/dev/null 2>&1
  echo "Rollback complete. To go back: re-run install.sh and 'kurenai-ctl enable'."
}

cmd_restore() {
  local src="$BACKUPS/latest"
  [ -d "$src/hypr" ] || die "no backup at $src (nothing to restore)"
  cmd_stop
  move_aside
  cp -a "$HYPR_DIR/hyprland.lua" "$HYPR_DIR/hyprland.lua.pre-restore-$(stamp)" 2>/dev/null
  cp -a "$src/hypr/hyprland.lua" "$HYPR_DIR/hyprland.lua" || die "restore of hyprland.lua failed"
  command -v hyprctl >/dev/null && hyprctl reload >/dev/null 2>&1
  echo "hyprland.lua restored from $(readlink -f "$src")."
}

# ------------------------------------------------------------------ validate
PASS=0; WARN=0; FAIL=0
ok()   { printf '  [ ok ] %s\n' "$*"; PASS=$((PASS+1)); }
warn() { printf '  [warn] %s\n' "$*"; WARN=$((WARN+1)); }
bad()  { printf '  [FAIL] %s\n' "$*"; FAIL=$((FAIL+1)); }

cmd_validate() {
  echo "Versions"
  if command -v hyprctl >/dev/null; then
    ok "$(hyprctl version 2>/dev/null | head -1)"
  else bad "hyprctl not found"; fi
  if command -v pacman >/dev/null; then
    pacman -Q quickshell >/dev/null 2>&1 && ok "$(pacman -Q quickshell)" || bad "quickshell not installed"
  fi
  command -v qs >/dev/null && ok "qs binary: $(command -v qs)" || bad "qs not on PATH"

  echo "Files"
  [ -f "$HYPR_DIR/hyprland.lua" ] && ok "hyprland.lua present" || bad "hyprland.lua missing (Lua config required)"
  [ -f "$HYPR_DIR/kurenai.lua" ]  && ok "kurenai.lua installed" || warn "kurenai.lua not installed"
  if [ -f "$HYPR_DIR/hyprland.lua" ] && grep -qF "$MARK" "$HYPR_DIR/hyprland.lua"; then
    ok "theme hook present in hyprland.lua"
  else warn "theme hook NOT in hyprland.lua (run: kurenai-ctl enable)"; fi
  [ -f "$QS_DIR/kurenai/shell.qml" ] && ok "quickshell/kurenai/shell.qml present" || bad "quickshell/kurenai/shell.qml missing"
  [ -f "$QS_DIR/kurenai/qmldir" ]    && ok "qmldir present" || bad "qmldir missing"

  echo "Lua syntax"
  if command -v luac >/dev/null; then
    luac -p "$HYPR_DIR/kurenai.lua" 2>/dev/null && ok "kurenai.lua parses (luac)" || bad "kurenai.lua has a syntax error"
  else warn "luac not installed; skipping syntax check (optional)"; fi

  echo "Hyprland config errors"
  if command -v hyprctl >/dev/null; then
    local errs; errs="$(hyprctl configerrors 2>/dev/null)"
    [ -z "$errs" ] && ok "none reported" || { warn "hyprctl configerrors says:"; printf '%s\n' "$errs" | sed 's/^/         /'; }
  fi

  echo "Services the bar reads"
  systemctl is-active --quiet NetworkManager && ok "NetworkManager active" \
    || warn "NetworkManager not active: the network indicator will show 'offline'"
  systemctl --user is-active --quiet pipewire && ok "PipeWire active (user)" \
    || warn "PipeWire not active (user): audio indicators will be empty"
  systemctl --user is-active --quiet wireplumber && ok "WirePlumber active (user)" \
    || warn "WirePlumber not active (user): default sink/source may be unavailable"
  if command -v pacman >/dev/null; then
    pacman -Q upower >/dev/null 2>&1 && ok "upower installed (starts on demand)" \
      || warn "upower not installed: battery indicator will be hidden"
  fi

  echo "Fonts"
  fc-list 2>/dev/null | grep -qi "JetBrainsMono Nerd" && ok "JetBrainsMono Nerd Font" || warn "JetBrainsMono Nerd Font missing: icons will be tofu"
  fc-list 2>/dev/null | grep -qi "Adwaita Sans"       && ok "Adwaita Sans" || warn "Adwaita Sans missing: UI falls back to default font"
  [ -n "$(fc-list :lang=ja family 2>/dev/null | head -1)" ] && ok "a Japanese-capable font is installed" \
    || warn "no Japanese font: the decorative kanji will show as a box (pacman -S noto-fonts-cjk)"

  echo "Possible conflicts"
  for p in waybar mako dunst swaync; do
    pgrep -x "$p" >/dev/null && warn "$p is running (phase 2 notification centre will need the notification daemon to be stopped)"
  done
  pgrep -f 'qs -c kurenai|quickshell -c kurenai' >/dev/null && ok "KURENAI shell is running" || warn "KURENAI shell is not running (start: qs -c kurenai)"

  printf '\n%d ok, %d warnings, %d failures\n' "$PASS" "$WARN" "$FAIL"
  [ "$FAIL" -eq 0 ]
}

case "${1:-}" in
  backup)   cmd_backup ;;
  enable)   cmd_enable ;;
  disable)  cmd_disable ;;
  validate) cmd_validate ;;
  stop)     cmd_stop ;;
  rollback) cmd_rollback ;;
  restore)  cmd_restore ;;
  *)        usage; [ -z "${1:-}" ] || exit 1 ;;
esac
