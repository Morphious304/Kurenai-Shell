#!/usr/bin/env bash
# kurenai-ctl: install-time helper for the KURENAI desktop shell. Everything is reversible.
# Touches only: ~/.config/hypr/hyprland.lua (up to three marked one-line hooks),
# ~/.config/hypr/kurenai*.lua, ~/.config/quickshell/kurenai/, ~/.local/share/kurenai/.
# It never edits your notification daemon's config; it can stop/start the daemon process.
set -u

CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
HYPR_DIR="$CFG/hypr"
QS_DIR="$CFG/quickshell"
STATE="${XDG_DATA_HOME:-$HOME/.local/share}/kurenai"
BACKUPS="$STATE/backups"
PREV_NOTIFIER="$STATE/previous-notifier"

# Hooks: one marked line each in hyprland.lua. Marker text must not contain another marker.
MARK_THEME="KURENAI-HOOK"
HOOK_THEME='local ok_k, err_k = pcall(require, "kurenai"); if not ok_k then print("[kurenai] " .. tostring(err_k)) end -- KURENAI-HOOK'
MARK_BINDS="KURENAI-BINDS-HOOK"
HOOK_BINDS='local ok_b, err_b = pcall(require, "kurenai-binds"); if not ok_b then print("[kurenai] " .. tostring(err_b)) end -- KURENAI-BINDS-HOOK'
MARK_AUTO="KURENAI-AUTOSTART-HOOK"
HOOK_AUTO='local ok_a, err_a = pcall(require, "kurenai-autostart"); if not ok_a then print("[kurenai] " .. tostring(err_a)) end -- KURENAI-AUTOSTART-HOOK'

MARK_LOCK="KURENAI-LOCK-HOOK"
HOOK_LOCK='local ok_l, err_l = pcall(require, "kurenai-lock"); if not ok_l then print("[kurenai] " .. tostring(err_l)) end -- KURENAI-LOCK-HOOK'

NOTIFIERS="mako dunst swaync"

die()   { printf 'kurenai-ctl: %s\n' "$*" >&2; exit 1; }
stamp() { date +%Y%m%d-%H%M%S; }
have()  { command -v "$1" >/dev/null 2>&1; }
reload_hypr() { have hyprctl && hyprctl reload >/dev/null 2>&1; }

# hook_active FILE MARKER: the marked hook line exists and is not commented out.
hook_active() { grep -F -- "$2" "$1" 2>/dev/null | grep -qv '^[[:space:]]*--'; }

# PIDs of running KURENAI shell processes, one per line.
#   shell_pids        one PID per shell (a child process of a shell is not counted again)
#   shell_pids all    every matching PID (use this to ask "is PID x part of the shell?")
# Read from the process table on purpose: plain `qs list` only looks at the 'default' Quickshell
# config, so it can never see `qs -c kurenai`. A process counts when its program is qs/quickshell,
# it was started with -c/--config kurenai, and it is not a short-lived subcommand (ipc, kill, ...).
shell_pids() {
  ps -ww -eo pid=,ppid=,args= 2>/dev/null | awk -v mode="${1:-roots}" '
    {
      if ($3 !~ /(^|\/)(qs|quickshell)$/) next
      named = 0
      for (i = 4; i <= NF; i++) {
        if ($i == "ipc" || $i == "kill" || $i == "list" || $i == "log" || $i == "msg") { named = 0; break }
        if (($i == "-c" || $i == "--config") && $(i + 1) == "kurenai") named = 1
        else if ($i == "--config=kurenai") named = 1
      }
      if (named) parent[$1] = $2
    }
    END {
      for (p in parent) if (mode == "all" || !(parent[p] in parent)) print p
    }' | sort -n
}
shell_running() { [ -n "$(shell_pids all)" ]; }

usage() {
  cat <<USAGE
Usage: kurenai-ctl <command>

 Setup
  backup             copy ~/.config/hypr and ~/.config/quickshell into $BACKUPS/<timestamp>
  validate           read-only health check (versions, services, fonts, files, conflicts)
  enable             theme: add ONE marked line to hyprland.lua (borders, gaps, motion)
  disable            theme: remove that line
  binds-check        read-only: compare KURENAI's keybinds with the binds Hyprland has active
  enable-binds       keybinds: add ONE marked line (run binds-check first)
  disable-binds      keybinds: remove that line
  enable-autostart   start the shell with the session: add ONE marked line
  disable-autostart  remove that line

 Shortcuts page
  shortcuts [cmd]    status (default) | toggle | rescan : talk to the running shell's shortcuts page (what it read, from which files)

 Running the shell
  start              start the shell detached (no duplicates)
  stop               stop the shell
  restart            stop, then start
  logs               show the shell's log (qs log)
  debug              stop the running shell, then run it in the foreground with live logs (Ctrl+C quits)
  media-binds        print (never apply) the brightness-key change for the OSD; only needed WITHOUT udevadm

 Clipboard history
  clip <cmd>         talk to the engine directly (kurenai-clip list|pins|status|...)
  clip-status        what is recording, how many entries, whether the database is private
  clip-wipe          delete the whole history (asks first; pinned items are kept)

 Lock screen (separate process: kurenai-lock)
  enable-lock        Hyprland side: restart-after-crash setting + start the lock process with the session
  disable-lock       remove that hook
  lock               lock the screen now
  lock-status        is the locker running, is the screen locked
  lock-preview       the lock screen in a normal window with the REAL password check; locks nothing
  lock-start/-stop   start / stop the lock process (stop is refused while locked)
  lock-recover       run from a TTY (Ctrl+Alt+F3) if the screen is stuck (grey / placeholder): restarts the locker
  lock-diagnose      one compact report for troubleshooting (works from a TTY; no passwords)
  lock-reset         the locker thinks the screen is locked but you are on your desktop: clean restart
  lock-hypridle      show the hypridle settings that make it lock on idle / before sleep
  lock-sync-theme    copy the main Theme.qml into the lock config after you edit the theme
  lock-harden        print the steps for a root-owned PAM service (stronger than the default)

 Notifications (only one program may own org.freedesktop.Notifications)
  notif-status       who owns it right now, and where mako/dunst/swaync are started
  notif-takeover     stop the running notification daemon so KURENAI can own the service
  notif-restore      stop the KURENAI shell and bring the previous daemon back

 Launcher (tabs: Apps | Run | Prime | Walls)
  reset-launcher     forget favourites, recents, Prime favourites and the Run command history
  rofi-theme         read-only: is the KURENAI Rofi theme installed, is Rofi using it, and how to switch it on

 Wallpaper colours (matugen)
  theme [status]     is it on, which scheme, which image the colours came from
  theme on|off       follow the wallpaper (on also applies the current one now) / back to the built-in KURENAI colours
  theme sync         recolour from the wallpaper awww shows right now
  theme type <name>  tonal-spot vibrant fidelity expressive neutral monochrome content fruit-salad rainbow (or: next)
  theme contrast N   -1 .. 1 (0 = standard)         theme accent wallpaper|vermilion   (vermilion = only neutrals follow)
  theme hypr on|off  Hyprland borders follow too     theme rofi on|off   Rofi theme follows too
  theme reset        built-in colours everywhere and forget the theme settings
  theme extras       app colours (kitty gtk qt btop yazi zathura nvim spicetify firefox): state; also: extras apply|follow on|off|reset
  theme extra <name> on|off   attach / detach one app (on = one-time setup in that app's config after a backup, then colours)
  theme-apply [--auto] <image>   recolour from a specific image (the Walls tab calls this)

 Undo
  rollback           stop shell, restore the old notifier, remove ALL hooks, move KURENAI files aside
  restore            rollback, and also restore hyprland.lua from the latest backup
USAGE
}

# ------------------------------------------------------------------ backup / hooks
cmd_backup() {
  local dir; dir="$BACKUPS/$(stamp)"
  mkdir -p "$dir" || die "cannot create $dir"
  [ -d "$HYPR_DIR" ] && cp -a "$HYPR_DIR" "$dir/hypr"
  [ -d "$QS_DIR" ]   && cp -a "$QS_DIR"   "$dir/quickshell"
  ln -sfn "$dir" "$BACKUPS/latest"
  echo "Backup written to $dir"
}

hook_add() {  # name mark line module-file
  local name="$1" mark="$2" line="$3" module="$4"
  local f="$HYPR_DIR/hyprland.lua"
  [ -f "$f" ] || die "$f not found (this setup targets the Lua config)"
  [ -f "$HYPR_DIR/$module" ] || die "$module is not installed; run install.sh first"
  if grep -qF "$mark" "$f"; then echo "$name: already enabled."; return 0; fi
  cmd_backup >/dev/null || die "backup failed; not touching hyprland.lua"
  printf '\n%s\n' "$line" >> "$f"
  reload_hypr
  echo "$name: enabled. Hyprland config errors (empty = none):"
  have hyprctl && hyprctl configerrors
  return 0
}

hook_remove() {  # name mark
  local name="$1" mark="$2" f="$HYPR_DIR/hyprland.lua"
  [ -f "$f" ] || return 0
  if grep -qF "$mark" "$f"; then
    cp -a "$f" "$f.pre-disable-$(stamp)"
    sed -i "/$mark/d" "$f"
    echo "$name: hook removed from hyprland.lua (copy kept as hyprland.lua.pre-disable-*)."
  else
    echo "$name: no hook found in hyprland.lua."
  fi
  reload_hypr
  return 0
}

cmd_enable()            { hook_add    "theme"     "$MARK_THEME" "$HOOK_THEME" "kurenai.lua"; }
cmd_disable()           { hook_remove "theme"     "$MARK_THEME"; }
cmd_enable_binds()      { hook_add    "binds"     "$MARK_BINDS" "$HOOK_BINDS" "kurenai-binds.lua"; }
cmd_disable_binds()     { hook_remove "binds"     "$MARK_BINDS"; }
cmd_enable_autostart()  { hook_add    "autostart" "$MARK_AUTO"  "$HOOK_AUTO"  "kurenai-autostart.lua"; }
cmd_disable_autostart() { hook_remove "autostart" "$MARK_AUTO"; }

# ------------------------------------------------------------------ running the shell
cmd_start() {
  have qs || die "qs (quickshell) not found on PATH"
  [ -f "$QS_DIR/kurenai/shell.qml" ] || die "KURENAI is not installed; run install.sh"
  if shell_running; then echo "KURENAI shell is already running (pid $(shell_pids | tr '\n' ' '))."; return 0; fi
  qs -n -d -c kurenai      # -n: do nothing if an instance of this config already exists, -d: detach
  sleep 1
  if shell_running; then echo "KURENAI shell started. Logs: kurenai-ctl logs"
  else echo "Started, but no KURENAI shell process was found. Check: kurenai-ctl logs  (or: kurenai-ctl debug)"; fi
}

cmd_stop() {
  local was=0 i p
  shell_running && was=1
  have qs && qs kill -c kurenai >/dev/null 2>&1 && was=1
  # One `qs kill` may end only one instance, so repeat until none is left (covers an accidental second shell).
  for i in 1 2 3 4; do
    sleep 0.3
    shell_running || break
    have qs && qs kill -c kurenai >/dev/null 2>&1 || break
  done
  if shell_running; then      # last resort: plain SIGTERM to the processes we identified
    for p in $(shell_pids all); do kill "$p" 2>/dev/null; done
    sleep 0.5
  fi
  if shell_running; then
    echo "Could not stop the KURENAI shell (pid $(shell_pids all | tr '\n' ' ')). Try: kill <pid>" >&2
    return 1
  fi
  # the clipboard recorders (Clipboard.qml) are children of the shell too: do not leave them recording
  pkill -f "$CLIP_WATCH_PAT" 2>/dev/null || true
  # the brightness watcher (System.qml) is a child process; make sure none is left behind
  pkill -f 'udevadm monitor --udev --subsystem-match=backlight' 2>/dev/null || true
  if [ "$was" -eq 1 ]; then echo "KURENAI shell stopped."; else echo "KURENAI shell was not running."; fi
  return 0
}

cmd_restart() { cmd_stop; sleep 1; cmd_start; }
cmd_logs()    { have qs || die "qs not found"; qs log -c kurenai 2>&1 | tail -n 80; }

# Foreground run with live logs. Stops a running shell first: a second shell would stack a second bar and
# print "Could not register notification server" (only one process may own org.freedesktop.Notifications).
cmd_debug() {
  have qs || die "qs (quickshell) not found on PATH"
  [ -f "$QS_DIR/kurenai/shell.qml" ] || die "KURENAI is not installed; run install.sh"
  if shell_running; then
    echo "A KURENAI shell is already running; stopping it first so there is only ever one."
    cmd_stop || die "could not stop the running shell"
    sleep 1
  fi
  echo "Running in the foreground. Ctrl+C quits. When you are done: kurenai-ctl start"
  qs -c kurenai
}

# ------------------------------------------------------------------ notifications
notif_owner() {  # prints "pid comm" of the current owner, or nothing
  have busctl || return 0
  busctl --user status org.freedesktop.Notifications 2>/dev/null | awk -F= '/^PID=/{p=$2} /^Comm=/{c=$2} END{if(p!="") print p, c}'
}

cmd_notif_status() {
  local o; o="$(notif_owner)"
  if [ -n "$o" ]; then echo "org.freedesktop.Notifications is owned by: $o"
  else echo "org.freedesktop.Notifications: no owner (or busctl unavailable)"; fi
  local n
  for n in $NOTIFIERS; do
    pgrep -x "$n" >/dev/null && echo "  running: $n"
    systemctl --user is-active --quiet "$n" 2>/dev/null && echo "  user unit active: $n"
  done
  echo "Where these daemons might be started from (edit/comment these out yourself; kurenai-ctl will not):"
  grep -nE 'mako|dunst|swaync' "$HYPR_DIR"/*.lua 2>/dev/null | sed 's/^/  /' || true
  [ -d "$CFG/systemd/user" ] && grep -rlE 'mako|dunst|swaync' "$CFG/systemd/user" 2>/dev/null | sed 's/^/  unit file: /'
  return 0
}

cmd_notif_takeover() {
  mkdir -p "$STATE"
  local n found=""
  for n in $NOTIFIERS; do
    if systemctl --user is-active --quiet "$n" 2>/dev/null; then
      printf '%s unit\n' "$n" > "$PREV_NOTIFIER"
      systemctl --user stop "$n" && echo "Stopped user unit: $n"
      found="$n"; break
    elif pgrep -x "$n" >/dev/null; then
      printf '%s proc\n' "$n" > "$PREV_NOTIFIER"
      pkill -x "$n" && echo "Stopped process: $n"
      found="$n"; break
    fi
  done
  [ -z "$found" ] && echo "No mako/dunst/swaync was running. Nothing to stop."
  [ -n "$found" ] && echo "Remembered in $PREV_NOTIFIER; undo with: kurenai-ctl notif-restore"
  echo "Next: start the shell (kurenai-ctl start), then test:  notify-send 'KURENAI' 'hello'"
  echo "Also comment out any autostart of $found in your Hyprland config (see: kurenai-ctl notif-status)."
  return 0
}

cmd_notif_restore() {
  cmd_stop
  [ -f "$PREV_NOTIFIER" ] || { echo "No previous notification daemon was recorded."; return 0; }
  local n kind; read -r n kind < "$PREV_NOTIFIER"
  case " $NOTIFIERS " in *" $n "*) ;; *) die "unexpected value in $PREV_NOTIFIER";; esac
  sleep 1
  if [ "$kind" = "unit" ]; then
    systemctl --user start "$n" && echo "Started user unit: $n"
  else
    have "$n" || die "$n not found on PATH"
    setsid "$n" >/dev/null 2>&1 < /dev/null &
    echo "Started: $n"
  fi
  return 0
}

# ------------------------------------------------------------------ launcher
cmd_reset_launcher() {
  mkdir -p "$STATE"
  printf '{\n  "favorites": [],\n  "recent": [],\n  "primeFavorites": [],\n  "primeRecent": []\n}\n' > "$STATE/launcher.json"
  # the Run tab's history can contain secrets typed into commands: recreate it empty and private
  ( umask 077; printf '{\n  "commands": []\n}\n' > "$STATE/runhistory.json" )
  chmod 600 "$STATE/runhistory.json" 2>/dev/null || true
  echo "launcher.json and runhistory.json reset. Restart the shell to reload them: kurenai-ctl restart"
}

# Read-only. KURENAI never edits your Rofi config; it only tells you the one line to add.
cmd_rofi_theme() {
  local theme="$CFG/rofi/themes/kurenai.rasi" rc="$CFG/rofi/config.rasi"
  have rofi || echo "note: rofi is not installed (pacman -S rofi); the theme is only used by the Rofi fallback."
  if [ -f "$theme" ]; then echo "theme file:   $theme"
  else echo "theme file:   MISSING ($theme). Re-run install.sh, or copy rofi/kurenai.rasi there."; fi
  if [ -f "$rc" ] && grep -Eq '^[[:space:]]*@theme[[:space:]]+"?(kurenai|.*kurenai\.rasi)' "$rc"; then
    echo "config.rasi:  already uses it ($rc)"
  else
    echo "config.rasi:  does not use it yet. To make it Rofi's default, add this line at the TOP of $rc:"
    echo '                @theme "kurenai"'
    echo "              (the KURENAI fallback bind already passes -theme kurenai, so this is only for Rofi started other ways)"
  fi
  echo "try it once:  rofi -show drun -theme kurenai"
  echo "undo:         remove that one line from config.rasi (nothing else was changed)"
}

# ------------------------------------------------------------------ wallpaper colours (matugen)
# One writer for everything: matugen renders three templates (shell palette, Rofi theme, Hyprland borders) into
# $STATE/next/, they are sanity-checked, and only then copied into place. A failure at any step leaves the
# colours you already have. `kurenai-ctl theme off` restores the built-in KURENAI colours everywhere.
THEME_CONF="$STATE/theme.conf"       # key=value: enabled type contrast accent hypr rofi
THEME_SRC="$STATE/theme.source"      # the image the current palette was made from
THEME_PAL="$STATE/palette.json"      # read live by the shell and the lock screen
THEME_TPL="$STATE/matugen"           # templates (installed by install.sh)
THEME_TYPES="tonal-spot vibrant fidelity expressive neutral monochrome content fruit-salad rainbow"

theme_get() {   # theme_get KEY DEFAULT
  local v=""
  [ -f "$THEME_CONF" ] && v="$(sed -n "s/^$1=//p" "$THEME_CONF" | tail -n 1)"
  printf '%s' "${v:-$2}"
}
theme_set() {   # theme_set KEY VALUE  (rewrites the small file, keeps the other keys)
  mkdir -p "$STATE"
  local tmp="$THEME_CONF.tmp.$$"
  { [ -f "$THEME_CONF" ] && grep -v "^$1=" "$THEME_CONF"; printf '%s=%s\n' "$1" "$2"; } > "$tmp" && mv "$tmp" "$THEME_CONF"
}
theme_enabled() { [ "$(theme_get enabled 0)" = "1" ]; }

# write $2 over $1 in place (same inode: the shell's file watcher keeps following it)
theme_put() { mkdir -p "$(dirname "$1")"; cat "$2" > "$1"; }

theme_hypr_reload() {
  [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && have hyprctl || return 0
  hyprctl reload >/dev/null 2>&1 || true
}

# Built-in colours everywhere (palette off, Hyprland file empty, Rofi theme back to the shipped one).
theme_restore_defaults() {
  mkdir -p "$STATE"
  printf '{\n  "enabled": false\n}\n' > "$THEME_PAL.tmp.$$" && theme_put "$THEME_PAL" "$THEME_PAL.tmp.$$"; rm -f "$THEME_PAL.tmp.$$"
  local changed=0
  if [ -d "$HYPR_DIR" ]; then
    local empty="$STATE/next.empty.lua"
    printf -- '-- ~/.config/hypr/kurenai-colors.lua\n-- Empty = the built-in KURENAI colours. `kurenai-ctl theme-apply` fills this from your wallpaper (matugen);\n-- `kurenai-ctl theme reset` empties it again. Do not edit by hand: it is overwritten.\nreturn {}\n' > "$empty"
    cmp -s "$empty" "$HYPR_DIR/kurenai-colors.lua" 2>/dev/null || { theme_put "$HYPR_DIR/kurenai-colors.lua" "$empty"; changed=1; }
    rm -f "$empty"
  fi
  if [ -f "$THEME_TPL/kurenai.default.rasi" ] && [ -d "$CFG/rofi/themes" ]; then
    cp "$THEME_TPL/kurenai.default.rasi" "$CFG/rofi/themes/kurenai.rasi"
  fi
  [ "$changed" = 1 ] && theme_hypr_reload
  return 0
}

theme_matugen_version() { matugen --version 2>/dev/null | head -n 1; }

cmd_theme_apply() {
  local auto=0 img=""
  while [ $# -gt 0 ]; do
    case "$1" in --auto) auto=1 ;; --) shift; img="${1:-}"; break ;; -*) die "theme-apply: unknown option $1" ;; *) img="$1" ;; esac
    shift
  done
  if [ "$auto" = 1 ] && ! theme_enabled; then return 0; fi          # the shell calls this after every wallpaper: silent when off
  [ -n "$img" ] || die "usage: kurenai-ctl theme-apply [--auto] <image>"
  have matugen || die "matugen is not installed (sudo pacman -S matugen)"
  [ -f "$img" ] && [ -r "$img" ] || die "cannot read image: $img"
  [ -d "$THEME_TPL" ] && [ -f "$THEME_TPL/palette.json.tpl" ] || die "templates missing in $THEME_TPL (re-run install.sh)"
  case "$STATE$CFG" in *\'*) die "your config or data folder path contains a single quote; refusing (it would break matugen's config file)" ;; esac

  mkdir -p "$STATE/next"
  exec 9>"$STATE/.theme.lock"
  if have flock; then flock -w 15 9 || die "another theme update is still running"; fi

  local type contrast accent hypr rofi
  type="$(theme_get type tonal-spot)"; contrast="$(theme_get contrast 0)"; accent="$(theme_get accent wallpaper)"
  hypr="$(theme_get hypr 1)"; rofi="$(theme_get rofi 1)"
  case " $THEME_TYPES " in *" $type "*) ;; *) type=tonal-spot ;; esac

  # matugen's config: one block per output. Everything is first rendered into $STATE/next/.
  local cfg="$STATE/matugen.toml" next="$STATE/next"
  rm -f "$next"/palette.json "$next"/kurenai.rasi "$next"/kurenai-colors.lua
  {
    printf '# generated by kurenai-ctl theme-apply: do not edit\n[config]\n\n'
    printf "[templates.palette]\ninput_path = '%s/palette.json.tpl'\noutput_path = '%s/palette.json'\n\n" "$THEME_TPL" "$next"
    if [ "$rofi" = 1 ] && [ -f "$THEME_TPL/kurenai.rasi.tpl" ] && [ -d "$CFG/rofi" ]; then
      printf "[templates.rofi]\ninput_path = '%s/kurenai.rasi.tpl'\noutput_path = '%s/kurenai.rasi'\n\n" "$THEME_TPL" "$next"
    fi
    if [ "$hypr" = 1 ] && [ -f "$THEME_TPL/kurenai-colors.lua.tpl" ] && [ -d "$HYPR_DIR" ]; then
      printf "[templates.hypr]\ninput_path = '%s/kurenai-colors.lua.tpl'\noutput_path = '%s/kurenai-colors.lua'\n\n" "$THEME_TPL" "$next"
    fi
  } > "$cfg"

  # flags differ between matugen generations: ask the installed one what it knows
  local help flags=()
  help="$(matugen image --help 2>&1 || true)"
  case "$help" in *--prefer*) flags+=(--prefer saturation) ;; esac     # 4.x: needed when there is no terminal (else it refuses to choose a colour)
  if [ "$contrast" != "0" ]; then case "$help" in *--contrast*) flags+=(--contrast "$contrast") ;; esac; fi

  local log="$STATE/next/matugen.log"
  if have timeout; then
    timeout 30 matugen image "$img" -c "$cfg" -m dark -t "scheme-$type" "${flags[@]}" -q </dev/null >"$log" 2>&1
  else
    matugen image "$img" -c "$cfg" -m dark -t "scheme-$type" "${flags[@]}" -q </dev/null >"$log" 2>&1
  fi || { echo "matugen failed: $(grep -v '^$' "$log" | head -n 1)" >&2; return 1; }

  # sanity checks before anything is replaced
  [ -s "$next/palette.json" ] && grep -q '"enabled": true' "$next/palette.json" && ! grep -q '{{' "$next/palette.json" \
    || { echo "matugen produced no usable palette (see $log)" >&2; return 1; }
  if [ -f "$next/kurenai.rasi" ]; then
    grep -q '^window {' "$next/kurenai.rasi" && ! grep -q '{{' "$next/kurenai.rasi" || { echo "rofi theme render looks wrong; keeping the old one" >&2; rm -f "$next/kurenai.rasi"; }
  fi
  if [ -f "$next/kurenai-colors.lua" ]; then
    if grep -q '{{' "$next/kurenai-colors.lua" || { have luac5.4 && ! luac5.4 -p "$next/kurenai-colors.lua" 2>/dev/null; } || { have luac && ! luac -p "$next/kurenai-colors.lua" 2>/dev/null; }; then
      echo "hyprland colours render looks wrong; keeping the old ones" >&2; rm -f "$next/kurenai-colors.lua"
    fi
  fi

  # "keep my vermilion accent": only the neutrals follow the wallpaper
  if [ "$accent" = "vermilion" ]; then
    sed -i 's/"pinAccent": false/"pinAccent": true/' "$next/palette.json"
    [ -f "$next/kurenai-colors.lua" ] && sed -i 's/pinAccent  = false/pinAccent  = true/' "$next/kurenai-colors.lua"
    [ -f "$next/kurenai.rasi" ] && sed -i -e 's/^\(    accent:      \)#[0-9A-Fa-f]*;/\1#F04436;/' -e 's/^\(    accent-text: \)#[0-9A-Fa-f]*;/\1#FF6B5C;/' \
        -e 's/^\(    ink:         \)#[0-9A-Fa-f]*;/\1#1A1A1A;/' -e 's/^\(    teal:        \)#[0-9A-Fa-f]*;/\1#70A6A0;/' "$next/kurenai.rasi"
  fi

  local hypr_changed=0
  if [ -f "$next/kurenai-colors.lua" ]; then
    cmp -s "$next/kurenai-colors.lua" "$HYPR_DIR/kurenai-colors.lua" 2>/dev/null || { theme_put "$HYPR_DIR/kurenai-colors.lua" "$next/kurenai-colors.lua"; hypr_changed=1; }
  fi
  [ -f "$next/kurenai.rasi" ] && cp "$next/kurenai.rasi" "$CFG/rofi/themes/kurenai.rasi"
  theme_put "$THEME_PAL" "$next/palette.json"          # last: the shell and the lock screen switch now
  printf '%s\n' "$img" > "$THEME_SRC"
  [ "$hypr_changed" = 1 ] && theme_hypr_reload
  theme_extras_apply auto || true                      # kitty, gtk, qt ... (only the ones you attached)
  [ "$auto" = 1 ] || echo "colours updated from: $img  (scheme-$type, $(theme_matugen_version))"
  return 0
}

# the wallpaper awww shows right now (first output that has an image)
theme_current_wallpaper() {
  have awww || return 1
  awww query -j 2>/dev/null | grep -o '"image": *"[^"]*"' | head -n 1 | sed 's/^"image": *"//; s/"$//'
}

cmd_theme_sync() {
  local auto=0 force=0 a
  for a in "$@"; do case "$a" in --auto) auto=1 ;; --force) force=1 ;; esac; done
  if [ "$auto" = 1 ] && ! theme_enabled; then return 0; fi
  local cur; cur="$(theme_current_wallpaper || true)"
  if [ -z "$cur" ]; then
    [ "$auto" = 1 ] || echo "no wallpaper reported by awww (is awww-daemon running and a wallpaper set?)" >&2
    return 1
  fi
  if [ "$force" = 0 ] && [ -f "$THEME_SRC" ] && [ "$(cat "$THEME_SRC" 2>/dev/null)" = "$cur" ] && [ -s "$THEME_PAL" ] && grep -q '"enabled": true' "$THEME_PAL"; then
    [ "$auto" = 1 ] || echo "colours already match the current wallpaper"
    return 0
  fi
  if [ "$auto" = 1 ]; then cmd_theme_apply --auto "$cur"; else cmd_theme_apply "$cur"; fi
}

cmd_theme() {
  local act="${1:-status}"; [ $# -gt 0 ] && shift
  case "$act" in
    status)
      echo "wallpaper colours: $(theme_enabled && echo ON || echo off)"
      echo "  matugen:   $(have matugen && theme_matugen_version || echo 'not installed (sudo pacman -S matugen)')"
      echo "  scheme:    $(theme_get type tonal-spot)   contrast: $(theme_get contrast 0)   accent: $(theme_get accent wallpaper)"
      echo "  also:      hyprland borders: $([ "$(theme_get hypr 1)" = 1 ] && echo on || echo off), rofi theme: $([ "$(theme_get rofi 1)" = 1 ] && echo on || echo off)"
      echo "  source:    $(cat "$THEME_SRC" 2>/dev/null || echo none)"
      echo "  palette:   $(grep -q '"enabled": true' "$THEME_PAL" 2>/dev/null && echo 'in use' || echo 'built-in KURENAI colours')   ($THEME_PAL)"
      echo "  templates: $([ -f "$THEME_TPL/palette.json.tpl" ] && echo installed || echo "MISSING (re-run install.sh)")"
      echo "  app colours attached: $(extras_list | sed 's/,/, /g; s/^$/none/')   (kurenai-ctl theme extras)"
      ;;
    on)
      have matugen || die "matugen is not installed (sudo pacman -S matugen)"
      theme_set enabled 1
      echo "wallpaper colours: ON"
      cmd_theme_sync --force || echo "(no colours yet: set a wallpaper from the launcher's Walls tab, or run: kurenai-ctl theme sync)"
      ;;
    off)
      theme_set enabled 0
      theme_restore_defaults
      theme_extras_apply || true
      echo "wallpaper colours: off (built-in KURENAI colours restored in the shell, lock screen, Rofi and Hyprland, and in any attached app colours)"
      ;;
    reset)
      theme_set enabled 0
      theme_restore_defaults
      cmd_theme_extras reset
      rm -f "$THEME_CONF" "$THEME_SRC" "$STATE/matugen.toml"
      rm -rf "$STATE/next"
      echo "wallpaper colours reset: built-in colours restored and theme settings forgotten"
      ;;
    sync) cmd_theme_sync --force ;;
    extras) cmd_theme_extras "$@" ;;
    extra)  cmd_theme_extra "$@" ;;
    type)
      local t="${1:-}"
      if [ "$t" = "next" ]; then
        local cur nx first="" take=0; cur="$(theme_get type tonal-spot)"; nx=""
        for x in $THEME_TYPES; do [ -z "$first" ] && first="$x"; if [ "$take" = 1 ]; then nx="$x"; break; fi; [ "$x" = "$cur" ] && take=1; done
        t="${nx:-$first}"
      fi
      case " $THEME_TYPES " in *" $t "*) ;; *) die "scheme must be one of: $THEME_TYPES  (or: next)" ;; esac
      theme_set type "$t"; echo "scheme: $t"
      theme_enabled && { cmd_theme_sync --force --auto || true; }
      ;;
    contrast)
      case "${1:-}" in -1|0|1|-0.[0-9]*|0.[0-9]*) ;; *) die "contrast is a number from -1 to 1 (0 = standard)" ;; esac
      theme_set contrast "$1"; echo "contrast: $1"
      theme_enabled && { cmd_theme_sync --force --auto || true; }
      ;;
    accent)
      case "${1:-}" in wallpaper|vermilion) ;; *) die "usage: kurenai-ctl theme accent wallpaper|vermilion" ;; esac
      theme_set accent "$1"; echo "accent: $1"
      theme_enabled && { cmd_theme_sync --force --auto || true; }
      ;;
    hypr|rofi)
      case "${1:-}" in on|off) ;; *) die "usage: kurenai-ctl theme $act on|off" ;; esac
      theme_set "$act" "$([ "$1" = on ] && echo 1 || echo 0)"; echo "$act: $1"
      if theme_enabled; then
        if [ "$1" = off ]; then theme_restore_defaults_part "$act"; fi
        cmd_theme_sync --force --auto || true
      fi
      ;;
    *) die "usage: kurenai-ctl theme [status|on|off|reset|sync|type <name|next>|contrast <-1..1>|accent wallpaper|vermilion|hypr on|off|rofi on|off|extras|extra <name> on|off]" ;;
  esac
}

# switch one extra off without touching the shell palette
theme_restore_defaults_part() {
  case "$1" in
    hypr)
      [ -d "$HYPR_DIR" ] || return 0
      printf -- '-- ~/.config/hypr/kurenai-colors.lua\n-- Empty = the built-in KURENAI colours. `kurenai-ctl theme-apply` fills this from your wallpaper (matugen);\n-- `kurenai-ctl theme reset` empties it again. Do not edit by hand: it is overwritten.\nreturn {}\n' > "$STATE/next.empty.lua"
      theme_put "$HYPR_DIR/kurenai-colors.lua" "$STATE/next.empty.lua"; rm -f "$STATE/next.empty.lua"; theme_hypr_reload ;;
    rofi)
      [ -f "$THEME_TPL/kurenai.default.rasi" ] && [ -d "$CFG/rofi/themes" ] && cp "$THEME_TPL/kurenai.default.rasi" "$CFG/rofi/themes/kurenai.rasi" ;;
  esac
  return 0
}

# ------------------------------------------------------------------ app colours ("extras"): kitty gtk qt btop yazi zathura nvim spicetify firefox
# Each extra is a few templates (~/.local/share/kurenai/extras/<name>/) filled from the SAME colours the shell uses
# (palette.json, or the built-in KURENAI colours when wallpaper colours are off), so apps and shell always match.
#   theme extra <name> on   : one-time setup (a marked block / one setting in that app's own config, after a backup), then colours
#   theme extra <name> off  : undo that setup and delete the generated files: the app goes back to your own look
#   theme extras            : state of all of them        theme extras reset : detach every extra
# Generated files are only ever written to places named in the extra's MANIFEST.
EXTRAS_ALL="kitty gtk qt btop yazi zathura nvim spicetify firefox"
EXTRAS_DIR="$STATE/extras"

extra_known()    { case " $EXTRAS_ALL " in *" $1 "*) return 0 ;; esac; return 1; }
extras_list()    { theme_get extras ""; }
extra_attached() { case ",$(extras_list)," in *",$1,"*) return 0 ;; esac; return 1; }
extras_save() {  # extras_save "a b c" -> theme.conf extras=a,b,c (in canonical order)
  local out="" x
  for x in $EXTRAS_ALL; do case " $1 " in *" $x "*) out="${out:+$out,}$x" ;; esac; done
  theme_set extras "$out"
}
extra_attach() { extra_attached "$1" || extras_save "$(extras_list | tr ',' ' ') $1"; }
extra_detach() { local x l=""; for x in $(extras_list | tr ',' ' '); do [ "$x" = "$1" ] || l="$l $x"; done; extras_save "$l"; }

ex_path() {
  local p="${1//@CFG@/$CFG}"; p="${p//@DATA@/${XDG_DATA_HOME:-$HOME/.local/share}}"
  case "$p" in *@FFPROFILE@*) p="${p//@FFPROFILE@/$(firefox_profile_dir 2>/dev/null || printf '%s' /nonexistent-firefox-profile)}" ;; esac
  printf '%s' "$p"
}

# ---- managed blocks inside a file you own (kitty.conf, gtk.css, ...)
ex_mark() {   # ex_mark begin|end hash|css
  case "$2:$1" in
    css:begin) printf '%s' '/* >>> KURENAI colours (kurenai-ctl theme): managed block, do not edit >>> */' ;;
    css:end)   printf '%s' '/* <<< KURENAI colours <<< */' ;;
    js:begin)  printf '%s' '// >>> KURENAI colours (kurenai-ctl theme): managed block, do not edit >>>' ;;
    js:end)    printf '%s' '// <<< KURENAI colours <<<' ;;
    *:begin)   printf '%s' '# >>> KURENAI colours (kurenai-ctl theme): managed block, do not edit >>>' ;;
    *:end)     printf '%s' '# <<< KURENAI colours <<<' ;;
  esac
}
ex_has_block() { [ -f "$1" ] && grep -qF "$(ex_mark begin "$2")" "$1"; }
ex_backup() {   # copy a file of yours aside before the first change
  [ -f "$1" ] || return 0
  ex_has_block "$1" hash && return 0; ex_has_block "$1" css && return 0; ex_has_block "$1" js && return 0
  mkdir -p "$EXTRAS_DIR/backup"
  cp -p "$1" "$EXTRAS_DIR/backup/$(basename "$1").$(stamp)" 2>/dev/null || true
}
ex_block_put() {   # ex_block_put FILE STYLE CONTENTFILE : replace (or add) the managed block; the rest of the file is untouched
  local f="$1" style="$2" content="$3" b e tmp
  b="$(ex_mark begin "$style")"; e="$(ex_mark end "$style")"
  mkdir -p "$(dirname "$f")"
  tmp="$(mktemp "$STATE/next/blk.XXXXXX")"
  if [ ! -f "$f" ]; then
    { printf '%s\n' "$b"; cat "$content"; printf '%s\n' "$e"; } > "$tmp"
  elif ex_has_block "$f" "$style"; then
    awk -v b="$b" -v e="$e" -v cf="$content" 'BEGIN{while((getline l<cf)>0) c=c l "\n"} index($0,b){printf "%s\n%s%s\n",b,c,e; skip=1; next} skip&&index($0,e){skip=0; next} !skip{print}' "$f" > "$tmp"
  else
    ex_backup "$f"
    { cat "$f"; [ -s "$f" ] && [ "$(tail -c1 "$f" | wc -l)" = 0 ] && echo; [ -s "$f" ] && echo; printf '%s\n' "$b"; cat "$content"; printf '%s\n' "$e"; } > "$tmp"
  fi
  cat "$tmp" > "$f"; rm -f "$tmp"        # in place: keeps symlinks (dotfile managers) and permissions
}
ex_block_put_top() {   # ex_block_put_top FILE STYLE CONTENTFILE : like ex_block_put, but a new block goes to the very top of the file
  local f="$1" style="$2" content="$3" b e tmp
  b="$(ex_mark begin "$style")"; e="$(ex_mark end "$style")"
  mkdir -p "$(dirname "$f")"
  tmp="$(mktemp "$STATE/next/blk.XXXXXX")"
  if [ ! -f "$f" ]; then
    { printf '%s\n' "$b"; cat "$content"; printf '%s\n' "$e"; } > "$tmp"
  elif ex_has_block "$f" "$style"; then
    awk -v b="$b" -v e="$e" -v cf="$content" 'BEGIN{while((getline l<cf)>0) c=c l "\n"} index($0,b){printf "%s\n%s%s\n",b,c,e; skip=1; next} skip&&index($0,e){skip=0; next} !skip{print}' "$f" > "$tmp"
  else
    ex_backup "$f"
    { printf '%s\n' "$b"; cat "$content"; printf '%s\n' "$e"; cat "$f"; } > "$tmp"
  fi
  cat "$tmp" > "$f"; rm -f "$tmp"
}
ex_block_remove() {   # ex_block_remove FILE STYLE : drop the managed block (and a file that held only that block)
  local f="$1" style="$2" b e tmp
  ex_has_block "$f" "$style" || return 0
  b="$(ex_mark begin "$style")"; e="$(ex_mark end "$style")"
  tmp="$(mktemp "$STATE/next/blk.XXXXXX")"
  # also drop the one blank line that was added in front of the block, so the file is back to exactly what it was
  awk -v b="$b" -v e="$e" 'skip{ if(index($0,e)) skip=0; next }
    index($0,b){ if(held>0) held--; skip=1; next }
    $0==""{ held++; next }
    { while(held>0){ print ""; held-- } print }
    END{ while(held>0){ print ""; held-- } }' "$f" > "$tmp"
  if ! grep -q '[^[:space:]]' "$tmp"; then rm -f "$f"; else cat "$tmp" > "$f"; fi
  rm -f "$tmp"
}

# ---- tiny INI helpers (qt5ct.conf / qt6ct.conf): set or remove one key in one section, rest untouched
ex_ini_get() { awk -v sec="[$2]" -v key="$3" '$0==sec{i=1;next} /^\[/{i=0} i&&index($0,key"=")==1{print substr($0,length(key)+2); exit}' "$1" 2>/dev/null; }
ex_ini_set() {   # file section key value
  local f="$1" tmp; tmp="$(mktemp "$STATE/next/ini.XXXXXX")"
  mkdir -p "$(dirname "$f")"; [ -f "$f" ] || : > "$f"
  awk -v sec="[$2]" -v key="$3" -v val="$4" '
    $0==sec{seen=1; ins=1; print; next}
    /^\[/{ if(ins&&!done){print key"="val; done=1}; ins=0 }
    ins&&index($0,key"=")==1{ if(!done){print key"="val; done=1}; next }
    {print}
    END{ if(ins&&!done) print key"="val; else if(!seen){ if(NR) print ""; print sec; print key"="val } }' "$f" > "$tmp"
  cat "$tmp" > "$f"; rm -f "$tmp"
}
ex_ini_unset() { local f="$1" tmp; [ -f "$f" ] || return 0; tmp="$(mktemp "$STATE/next/ini.XXXXXX")"
  awk -v sec="[$2]" -v key="$3" '$0==sec{i=1;print;next} /^\[/{i=0} i&&index($0,key"=")==1{next} {print}' "$f" > "$tmp"; cat "$tmp" > "$f"; rm -f "$tmp"; }

# ---- colours: the table every template is filled from
extras_make_tokens() {   # extras_make_tokens OUTFILE  (palette.json when wallpaper colours are on, else the built-in colours)
  local raw="$STATE/next/tokens.raw" k v pin=0
  mkdir -p "$STATE/next"
  cat > "$raw" <<'EOT'
bg #242424
surface #30302F
raised #3A3535
text #F4E8BE
text2 #D8CFB3
muted #A8A393
accent #F04436
accentText #FF6B5C
accentDeep #B8281E
inkOnAccent #1A1A1A
teal #70A6A0
rose #C98DB5
EOT
  if theme_enabled && [ -s "$THEME_PAL" ] && grep -q '"enabled": true' "$THEME_PAL"; then
    grep -q '"pinAccent": true' "$THEME_PAL" && pin=1
    for k in bg surface raised text text2 muted accent accentText accentDeep inkOnAccent teal rose; do
      if [ "$pin" = 1 ]; then case " accent accentText accentDeep inkOnAccent teal rose " in *" $k "*) continue ;; esac; fi
      v="$(sed -n "s/.*\"$k\": *\"\(#[0-9A-Fa-f]\{6\}\)\".*/\1/p" "$THEME_PAL" | head -n 1)"
      [ -n "$v" ] && printf '%s %s\n' "$k" "$v" >> "$raw"       # later line wins in tokens.awk
    done
  fi
  awk -f "$EXTRAS_DIR/tokens.awk" "$raw" > "$1"
}

# ---- one extra: fill its templates and put the results where they belong. Sets EX_CHANGED=1 if anything changed.
EX_CHANGED=0
extra_post_qt() {   # make the number of colours match what this machine's qt6ct/qt5ct ships (a different count is ignored by qt)
  local f="$1" tpl="$2" dir sample n
  case "$tpl" in qt6ct*) dir=/usr/share/qt6ct/colors ;; *) dir=/usr/share/qt5ct/colors ;; esac
  sample="$(ls "$dir"/*.conf 2>/dev/null | head -n 1)"; [ -n "$sample" ] || return 0
  n="$(grep -m1 '^active_colors=' "$sample" | tr ',' '\n' | wc -l)"; [ "$n" -ge 15 ] 2>/dev/null || return 0
  awk -v m="$n" 'BEGIN{FS=OFS="="} /^(active|inactive|disabled)_colors=/{ k=$1; v=substr($0,length($1)+2); c=split(v,a,","); out=""; for(i=1;i<=m;i++){ x=(i<=c)?a[i]:a[c]; out=out (i>1?",":"") x }; print k"="out; next } {print}' "$f" > "$f.n" && cat "$f.n" > "$f"; rm -f "$f.n"
}
extra_post_yazi() {   # yazi before 25.5 calls the [mgr] section [manager]
  local v major minor; v="$(yazi --version 2>/dev/null | grep -o '[0-9][0-9]*\.[0-9][0-9]*' | head -n 1)"
  [ -n "$v" ] || return 0; major="${v%%.*}"; minor="${v#*.}"
  if [ "$major" -lt 25 ] 2>/dev/null || { [ "$major" -eq 25 ] && [ "$minor" -lt 5 ]; }; then sed -i 's/^\[mgr\]/[manager]/' "$1"; fi
}
extra_render() {   # extra_render NAME TOKENFILE
  local name="$1" tok="$2" mf="$EXTRAS_DIR/$1/MANIFEST" kind tpl dest style tmp before after
  [ -f "$mf" ] || { echo "extra $name: templates missing in $EXTRAS_DIR/$name (re-run install.sh)" >&2; return 1; }
  while IFS='|' read -r kind tpl dest style; do
    case "$kind" in ''|\#*) continue ;; esac
    dest="$(ex_path "$dest")"
    case "$dest" in /nonexistent-firefox-profile*) echo "extra $name: Firefox profile not found, nothing written (check: kurenai-ctl theme extra firefox status)" >&2; return 1 ;; esac
    if [ "$kind" = once ] && [ -e "$dest" ]; then continue; fi
    tmp="$(mktemp "$STATE/next/ex.XXXXXX")"
    if ! awk -v tokens="$tok" -f "$EXTRAS_DIR/render.awk" "$EXTRAS_DIR/$name/$tpl" > "$tmp" 2>"$tmp.err" || grep -q '{{' "$tmp" || [ ! -s "$tmp" ]; then
      echo "extra $name: could not render $tpl: $(head -n 1 "$tmp.err")" >&2; rm -f "$tmp" "$tmp.err"; return 1
    fi
    rm -f "$tmp.err"
    command -v "extra_post_$name" >/dev/null 2>&1 && "extra_post_$name" "$tmp" "$tpl"
    mkdir -p "$(dirname "$dest")"
    case "$kind" in
      block) before=none; [ -f "$dest" ] && before="$(cksum < "$dest")"
             ex_block_put "$dest" "$style" "$tmp"; after="$(cksum < "$dest")"
             [ "$before" = "$after" ] || EX_CHANGED=1 ;;
      *)     if ! cmp -s "$tmp" "$dest" 2>/dev/null; then cat "$tmp" > "$dest"; EX_CHANGED=1; fi ;;
    esac
    rm -f "$tmp"
  done < "$mf"
  return 0
}
extra_reload() {   # only when the colours really changed; never fails
  case "$1" in
    kitty) have pkill && pkill -USR1 -x kitty 2>/dev/null ;;
    btop)  have pkill && pkill -USR2 -x btop 2>/dev/null ;;
    gtk)   if have gsettings && [ "$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null)" = "'adw-gtk3-dark'" ]; then
             gsettings set org.gnome.desktop.interface gtk-theme '' 2>/dev/null; gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3-dark 2>/dev/null
           fi ;;
  esac
  return 0
}

# re-render every attached extra (called after each wallpaper change, `theme on/off` and the installer)
theme_extras_apply() {   # [auto]  auto = respect `theme extras follow off`
  local l n tok="$STATE/next/tokens.eff" err
  l="$(extras_list)"; [ -n "$l" ] || return 0
  [ -f "$EXTRAS_DIR/tokens.awk" ] || return 0
  if [ "${1:-}" = auto ] && [ "$(theme_get extras_follow 1)" != 1 ]; then return 0; fi
  mkdir -p "$STATE/next"
  if ! err="$(extras_make_tokens "$tok" 2>&1)"; then echo "app colours not updated (the previous colours stay): $(printf '%s' "$err" | head -n 3 | tr '\n' ';')" >&2; return 1; fi
  for n in $(printf '%s' "$l" | tr ',' ' '); do
    extra_known "$n" || continue
    EX_CHANGED=0
    if extra_render "$n" "$tok" && [ "$EX_CHANGED" = 1 ]; then extra_reload "$n"; fi
  done
  return 0
}

# ---- one-time setup per extra (what `theme extra NAME on` does besides writing colours) -------------------------------
ex_need() { have "$1" || die "$1 is not installed ($2). Nothing was changed."; }
extra_setup_kitty() {
  ex_need kitty "sudo pacman -S kitty"
  local f="$CFG/kitty/kitty.conf" c; c="$(mktemp "$STATE/next/blk.XXXXXX")"
  echo 'include kurenai-colors.conf' > "$c"; ex_block_put "$f" hash "$c"; rm -f "$c"
  echo "  kitty.conf: one managed block added at the END (last setting wins), your own colour theme above it stays as it is."
  echo "  background_opacity / blur / fonts are not touched. Open windows reload by themselves (SIGUSR1)."
}
extra_teardown_kitty() { ex_block_remove "$CFG/kitty/kitty.conf" hash; rm -f "$CFG/kitty/kurenai-colors.conf"; have pkill && pkill -USR1 -x kitty 2>/dev/null; return 0; }

extra_setup_gtk() {
  local t=/usr/share/themes/adw-gtk3-dark d="${XDG_DATA_HOME:-$HOME/.local/share}/themes/adw-gtk3-dark"
  [ -d "$t" ] || [ -d "$d" ] || die "the adw-gtk3 theme is not installed (sudo pacman -S adw-gtk-theme). Nothing was changed."
  if have gsettings; then
    local cur; cur="$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null | tr -d "'")"
    mkdir -p "$EXTRAS_DIR"
    [ "$cur" = adw-gtk3-dark ] || [ -f "$EXTRAS_DIR/gtk.prev-theme" ] || printf '%s\n' "$cur" > "$EXTRAS_DIR/gtk.prev-theme"
    gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3-dark 2>/dev/null
    gsettings set org.gnome.desktop.interface color-scheme prefer-dark 2>/dev/null
    echo "  GTK theme: ${cur:-unset} -> adw-gtk3-dark (the old value is saved; 'theme extra gtk off' puts it back)"
  else
    echo "  gsettings not found: select the adw-gtk3-dark theme yourself (nwg-look)"
  fi
  echo "  Colours go into a managed block in ~/.config/gtk-4.0/gtk.css and gtk-3.0/gtk.css. Apps that are already open"
  echo "  need a restart (GTK3 apps are nudged to reload). Flatpak apps do not see ~/.config/gtk-*: see docs/THEME.md."
}
extra_teardown_gtk() {
  ex_block_remove "$CFG/gtk-4.0/gtk.css" css; ex_block_remove "$CFG/gtk-3.0/gtk.css" css
  if [ -f "$EXTRAS_DIR/gtk.prev-theme" ] && have gsettings; then
    gsettings set org.gnome.desktop.interface gtk-theme "$(cat "$EXTRAS_DIR/gtk.prev-theme")" 2>/dev/null; rm -f "$EXTRAS_DIR/gtk.prev-theme"
  fi
  return 0
}

extra_setup_qt() {
  have qt6ct || have qt5ct || die "neither qt6ct nor qt5ct is installed (sudo pacman -S qt6ct). Nothing was changed."
  local v d f prev
  for v in 6 5; do
    have "qt${v}ct" || continue
    f="$CFG/qt${v}ct/qt${v}ct.conf"; prev="$EXTRAS_DIR/qt${v}ct.prev"
    ex_backup "$f"
    if [ ! -f "$prev" ]; then
      { echo "custom_palette=$(ex_ini_get "$f" Appearance custom_palette)"; echo "color_scheme_path=$(ex_ini_get "$f" Appearance color_scheme_path)"; } > "$prev"
    fi
    ex_ini_set "$f" Appearance custom_palette true
    ex_ini_set "$f" Appearance color_scheme_path "$CFG/qt${v}ct/colors/kurenai.conf"
    echo "  qt${v}ct.conf: custom_palette=true, color_scheme_path=$CFG/qt${v}ct/colors/kurenai.conf   (style: $(ex_ini_get "$f" Appearance style))"
    case "$(ex_ini_get "$f" Appearance style | tr 'A-Z' 'a-z')" in *kvantum*) echo "  NOTE: qt${v}ct uses the Kvantum style, which brings its own colours and ignores this scheme. Pick the Fusion style in qt${v}ct to see the wallpaper colours.";; esac
  done
  printf 'qt6ct\n' > "$STATE/qt-env"
  echo "  Qt reads its platform theme from QT_QPA_PLATFORMTHEME (now: '${QT_QPA_PLATFORMTHEME:-unset}'). kurenai.lua sets it to qt6ct from the next"
  echo "  Hyprland config load; apps started before that, and Qt5 apps (they need 'qt5ct'), are not affected. If nothing changes, log out and in."
}
extra_teardown_qt() {
  local v f p
  for v in 6 5; do
    f="$CFG/qt${v}ct/qt${v}ct.conf"; p="$EXTRAS_DIR/qt${v}ct.prev"
    if [ -f "$p" ] && [ -f "$f" ]; then
      for key in custom_palette color_scheme_path; do
        val="$(sed -n "s/^$key=//p" "$p" | head -n 1)"
        if [ -n "$val" ]; then ex_ini_set "$f" Appearance "$key" "$val"; else ex_ini_unset "$f" Appearance "$key"; fi
      done
    fi
    rm -f "$p" "$CFG/qt${v}ct/colors/kurenai.conf"
  done
  rm -f "$STATE/qt-env"; return 0
}

extra_setup_btop() {
  ex_need btop "sudo pacman -S btop"
  local f="$CFG/btop/btop.conf" prev="$EXTRAS_DIR/btop.prev"
  mkdir -p "$CFG/btop" "$EXTRAS_DIR"; ex_backup "$f"
  [ -f "$prev" ] || { grep -m1 '^color_theme' "$f" 2>/dev/null | sed 's/^color_theme *= *//' > "$prev" || true; [ -f "$prev" ] || : > "$prev"; }
  if [ -f "$f" ] && grep -q '^color_theme' "$f"; then sed -i 's|^color_theme *=.*|color_theme = "kurenai"|' "$f"
  else printf 'color_theme = "kurenai"\n' >> "$f"; fi
  echo "  btop.conf: color_theme = \"kurenai\" (was: $(cat "$prev"))   Running btop windows reload by themselves (SIGUSR2). Background stays transparent."
}
extra_teardown_btop() {
  local f="$CFG/btop/btop.conf" prev="$EXTRAS_DIR/btop.prev" v
  if [ -f "$f" ] && [ -f "$prev" ]; then v="$(cat "$prev")"; [ -n "$v" ] || v='"Default"'; sed -i "s|^color_theme *=.*|color_theme = $v|" "$f"; fi
  rm -f "$prev" "$CFG/btop/themes/kurenai.theme"; have pkill && pkill -USR2 -x btop 2>/dev/null; return 0
}

extra_setup_yazi() {
  ex_need yazi "sudo pacman -S yazi"
  local f="$CFG/yazi/theme.toml" c; c="$(mktemp "$STATE/next/blk.XXXXXX")"
  if [ -f "$f" ] && grep -q '^\[flavor\]' "$f" && ! ex_has_block "$f" hash; then
    echo "  $f already has a [flavor] section, so I left it alone. Set it yourself:   dark = \"kurenai\"   light = \"kurenai\""
  else
    printf '[flavor]\ndark = "kurenai"\nlight = "kurenai"\n' > "$c"; ex_block_put "$f" hash "$c"
    echo "  theme.toml: managed [flavor] block added (flavor 'kurenai')."
  fi
  rm -f "$c"
  echo "  Yazi reads its theme at start: restart open yazi windows. If yazi complains about the flavor (for example a missing file), run 'kurenai-ctl theme extra yazi off' and tell me the message."
}
extra_teardown_yazi() { ex_block_remove "$CFG/yazi/theme.toml" hash; rm -rf "$CFG/yazi/flavors/kurenai.yazi"; return 0; }

extra_setup_zathura() {
  ex_need zathura "sudo pacman -S zathura"
  local c; c="$(mktemp "$STATE/next/blk.XXXXXX")"; echo 'include kurenai-colors' > "$c"
  ex_block_put "$CFG/zathura/zathurarc" hash "$c"; rm -f "$c"
  echo "  zathurarc: managed block 'include kurenai-colors' added. New zathura windows use it; open ones keep their colours."
}
extra_teardown_zathura() { ex_block_remove "$CFG/zathura/zathurarc" hash; rm -f "$CFG/zathura/kurenai-colors"; return 0; }

extra_setup_nvim() {
  ex_need nvim "sudo pacman -S neovim"
  echo "  Installed: a 'kurenai' colorscheme and a small watcher (nvim/plugin/kurenai-watch.lua) that reloads it when the colours change."
  echo "  Your Neovim config is NOT edited. Turn it on yourself, in init.lua:   vim.cmd.colorscheme(\"kurenai\")   (or try it with :colorscheme kurenai)"
  echo "  The editor background is transparent (matches a translucent terminal). Solid: put  vim.g.kurenai_transparent = false  before that line."
}
extra_teardown_nvim() { rm -f "$CFG/nvim/colors/kurenai.lua" "$CFG/nvim/plugin/kurenai-watch.lua"; return 0; }

extra_setup_spicetify() {
  ex_need spicetify "AUR: spicetify-cli"
  echo "  Installed: a 'kurenai' Spicetify theme (colours only). I do NOT run spicetify for you, because applying patches Spotify. To use it:"
  echo "    spicetify config current_theme kurenai        (if the colours do not change, also match color_scheme to the [base] section in color.ini)"
  echo "    close Spotify, then:  spicetify apply         (repeat after a colour change; the new colours show only after apply)"
}
extra_teardown_spicetify() {
  local d="$CFG/spicetify/Themes/kurenai"
  rm -f "$d/color.ini"
  # user.css is written once and may hold your own tweaks: it is removed only when it is still exactly what we wrote
  if [ -f "$d/user.css" ] && cmp -s "$d/user.css" "$EXTRAS_DIR/spicetify/user.css.tpl"; then rm -f "$d/user.css"; fi
  rmdir "$d" 2>/dev/null
  echo "  (if Spicetify still points at 'kurenai': spicetify config current_theme <your theme>; spicetify apply)"; return 0; }


# ---- Firefox -----------------------------------------------------------------------------------------------------------
# What `theme extra firefox on` changes, in your Firefox profile (found from profiles.ini, or given with --profile DIR):
#   chrome/userChrome.css   one managed block at the very top: @import url("kurenai/kurenai.css");   (your own rules stay below it)
#   chrome/userContent.css  one managed block at the very top: @import for Firefox's own pages (about:newtab, about:home, ...)
#   user.js                 one managed block: toolkit.legacyUserProfileCustomizations.stylesheets = true (Firefox ignores the two
#                           files above without it), and, only after `home on`, browser.startup.homepage = the start page
#   chrome/kurenai/         the generated colours + stylesheets (deleted again by `off`)
#   ~/.local/share/kurenai/firefox/   the start page (a local page: clock, search, tiles)
# The optional script layer (`script on`) copies ONE file, kurenai.uc.js, into chrome/JS/ and only when fx-autoconfig is installed.
# Nothing here ever writes to /usr or needs root. Firefox reads all of this at start-up: restart it to see a change.
firefox_roots() { printf '%s\n' "$CFG/mozilla/firefox" "$HOME/.mozilla/firefox"; }
firefox_ini_default() {   # firefox_ini_default ROOT : the default profile's folder from ROOT/profiles.ini; prints nothing if unclear
  local root="$1" ini="$1/profiles.ini" out isrel path
  [ -f "$ini" ] || return 1
  out="$(awk -F= '
    { sub(/\r$/, "") }
    /^\[/ { sec = $0; if (sec ~ /^\[Profile/) { n++; p[n] = ""; r[n] = 1; d[n] = 0 } next }
    sec ~ /^\[Install/ && $1 == "Default" && inst == "" { inst = substr($0, index($0, "=") + 1); next }
    sec ~ /^\[Profile/ && $1 == "Path" { p[n] = substr($0, index($0, "=") + 1); next }
    sec ~ /^\[Profile/ && $1 == "IsRelative" { r[n] = $2 + 0; next }
    sec ~ /^\[Profile/ && $1 == "Default" { d[n] = $2 + 0; next }
    END {
      if (inst != "") { printf "1\t%s\n", inst; exit }
      for (i = 1; i <= n; i++) if (d[i] == 1) { printf "%s\t%s\n", r[i], p[i]; exit }
      if (n == 1) printf "%s\t%s\n", r[1], p[1]
    }' "$ini")"
  [ -n "$out" ] || return 1
  IFS=$'\t' read -r isrel path <<< "$out"
  [ -n "$path" ] || return 1
  if [ "$isrel" = 1 ] && [ "${path#/}" = "$path" ]; then path="$root/$path"; fi
  [ -d "$path" ] || return 1
  printf '%s' "$path"
}
firefox_profile_dir() {   # the profile this extra works on: the one saved by --profile, else the default one from profiles.ini
  local p root; p="$(theme_get firefox_profile "")"
  if [ -n "$p" ]; then [ -d "$p" ] && { printf '%s' "$p"; return 0; }; return 1; fi
  while IFS= read -r root; do
    p="$(firefox_ini_default "$root")" && { printf '%s' "$p"; return 0; }
  done < <(firefox_roots)
  return 1
}
firefox_profiles_seen() {   # what to show when the right profile cannot be told
  local root; while IFS= read -r root; do
    [ -f "$root/profiles.ini" ] || continue
    echo "  $root/profiles.ini:"; grep -E '^(Name|Path|Default)=' "$root/profiles.ini" | sed 's/^/    /'
  done < <(firefox_roots)
}
firefox_start_dir() { printf '%s' "${XDG_DATA_HOME:-$HOME/.local/share}/kurenai/firefox"; }
firefox_userjs_write() {   # the one managed block in user.js (the stylesheet switch, plus the home page when `home on`)
  local p="$1" c d; c="$(mktemp "$STATE/next/blk.XXXXXX")"; d="$(firefox_start_dir)"
  {
    echo 'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);'
    [ "$(theme_get firefox_home 0)" = 1 ] && printf 'user_pref("browser.startup.homepage", "file://%s/start.html");\n' "${d// /%20}"
  } > "$c"
  ex_block_put "$p/user.js" js "$c"; rm -f "$c"
}
firefox_loader_ok() { [ -f "$1/chrome/utils/boot.sys.mjs" ]; }
firefox_program_ok() { [ -f /usr/lib/firefox/config.js ] || [ -f /usr/lib64/firefox/config.js ]; }
firefox_script_remove() { rm -f "$1/chrome/JS/kurenai.uc.js"; }

extra_setup_firefox() {
  have firefox || die "firefox is not installed (sudo pacman -S firefox). Nothing was changed."
  local prof="" p c
  while [ $# -gt 0 ]; do
    case "$1" in --profile) prof="${2:-}"; [ $# -ge 2 ] && shift ;; *) die "unknown option '$1' (only: --profile DIR)" ;; esac
    shift
  done
  if [ -n "$prof" ]; then
    prof="${prof/#\~/$HOME}"; [ -d "$prof" ] || die "no such folder: $prof. Nothing was changed."
    theme_set firefox_profile "$prof"
  fi
  if ! p="$(firefox_profile_dir)"; then
    echo "kurenai-ctl: could not tell which Firefox profile to use. Nothing was changed." >&2
    firefox_profiles_seen >&2
    die "pick one and run:  kurenai-ctl theme extra firefox on --profile /full/path/to/the/profile   (about:profiles in Firefox shows it)"
  fi
  [ -f "$p/prefs.js" ] || echo "  note: $p has no prefs.js yet; is it a profile Firefox has started with? (about:profiles)"
  c="$(mktemp "$STATE/next/blk.XXXXXX")"
  printf '@import url("kurenai/kurenai.css");\n' > "$c";         ex_block_put_top "$p/chrome/userChrome.css" css "$c"
  printf '@import url("kurenai/kurenai-content.css");\n' > "$c"; ex_block_put_top "$p/chrome/userContent.css" css "$c"
  rm -f "$c"; firefox_userjs_write "$p"
  echo "  profile: $p"
  echo "  chrome/userChrome.css and userContent.css: one managed @import line added at the very TOP; your own rules below it are untouched."
  echo "  user.js: one managed block (turns on userChrome.css loading). Firefox copies it into prefs.js; \`off\` removes the block, and that pref then stays true until you reset it in about:config."
  echo "  Firefox reads all of this at start-up: close every Firefox window and open it again. Websites are not recoloured."
  echo "  Tabs: turn on Firefox's vertical tabs from its own menu if you want the rail (right-click the tab strip); the stylesheet styles both layouts."
  echo "  Start page (optional):  kurenai-ctl theme extra firefox home on      Hide/show button and keys (optional):  kurenai-ctl theme extra firefox script on"
}
extra_teardown_firefox() {
  local p d; p="$(firefox_profile_dir 2>/dev/null)" || p=""
  if [ -n "$p" ]; then
    ex_block_remove "$p/chrome/userChrome.css" css
    ex_block_remove "$p/chrome/userContent.css" css
    ex_block_remove "$p/user.js" js
    rm -f "$p/chrome/kurenai/kurenai-colors.css" "$p/chrome/kurenai/kurenai.css" "$p/chrome/kurenai/kurenai-content.css"
    rmdir "$p/chrome/kurenai" 2>/dev/null
    firefox_script_remove "$p"
  else
    echo "  (could not find the Firefox profile any more: remove the KURENAI block at the top of chrome/userChrome.css and userContent.css by hand)"
  fi
  d="$(firefox_start_dir)"
  rm -f "$d/start-colors.css" "$d/start.css" "$d/start.html"
  # start-links.js holds your own links: removed only while it is still exactly what we wrote
  if [ -f "$d/start-links.js" ] && cmp -s "$d/start-links.js" "$EXTRAS_DIR/firefox/start-links.js"; then rm -f "$d/start-links.js"; fi
  rmdir "$d" 2>/dev/null
  theme_set firefox_home 0; theme_set firefox_profile ""
  echo "  Restart Firefox. If you used 'home on': Firefox has copied that home page into its own prefs.js, so it stays until you reset it (Settings > Home > Restore Defaults)."
  echo "  The preference toolkit.legacyUserProfileCustomizations.stylesheets stays true in prefs.js (harmless); reset it in about:config if you like."
  return 0
}
cmd_theme_firefox() {   # cmd_theme_firefox status|script|home|profile [args]
  local act="${1:-status}" p d; [ $# -gt 0 ] && shift
  case "$act" in
    profile)
      if [ -n "${1:-}" ]; then
        extra_attached firefox && die "firefox is attached: run 'theme extra firefox off' first, then 'on --profile DIR'"
        [ -d "$1" ] || die "no such folder: $1"; theme_set firefox_profile "$1"; echo "firefox profile: $1"
      else
        p="$(firefox_profile_dir)" && echo "$p" || { echo "no profile found"; firefox_profiles_seen; return 1; }
      fi ;;
    status)
      echo "firefox ($(timeout 5 firefox --version 2>/dev/null || echo 'not found'))   extra: $(extra_attached firefox && echo ATTACHED || echo off)"
      p="$(firefox_profile_dir 2>/dev/null)" || p=""
      if [ -z "$p" ]; then echo "  profile: not found (use: theme extra firefox on --profile DIR)"; firefox_profiles_seen; return 0; fi
      echo "  profile: $p"
      printf '  userChrome.css block: %s   userContent.css block: %s   user.js block: %s\n' \
        "$(ex_has_block "$p/chrome/userChrome.css" css && echo yes || echo no)" "$(ex_has_block "$p/chrome/userContent.css" css && echo yes || echo no)" "$(ex_has_block "$p/user.js" js && echo yes || echo no)"
      printf '  generated files: %s/3 in chrome/kurenai/   start page: %s   home page set: %s\n' \
        "$(ls "$p/chrome/kurenai/kurenai-colors.css" "$p/chrome/kurenai/kurenai.css" "$p/chrome/kurenai/kurenai-content.css" 2>/dev/null | wc -l)" \
        "$([ -f "$(firefox_start_dir)/start.html" ] && echo present || echo absent)" "$([ "$(theme_get firefox_home 0)" = 1 ] && echo yes || echo no)"
      printf '  script layer: fx-autoconfig in the profile: %s   in the Firefox folder (config.js): %s   kurenai.uc.js: %s\n' \
        "$(firefox_loader_ok "$p" && echo yes || echo no)" "$(firefox_program_ok && echo yes || echo 'not found')" "$([ -f "$p/chrome/JS/kurenai.uc.js" ] && echo installed || echo no)"
      pgrep -x firefox >/dev/null 2>&1 && echo "  Firefox is running now: restart it to load changes." ;;
    home)
      case "${1:-}" in on|off) ;; *) die "usage: kurenai-ctl theme extra firefox home on|off" ;; esac
      extra_attached firefox || die "attach first: kurenai-ctl theme extra firefox on"
      p="$(firefox_profile_dir)" || die "Firefox profile not found"
      theme_set firefox_home "$([ "$1" = on ] && echo 1 || echo 0)"; firefox_userjs_write "$p"
      if [ "$1" = on ]; then
        echo "home page: set to the KURENAI start page ($(firefox_start_dir)/start.html) from the next start. Firefox re-applies it on every start (user.js), so a home page you pick in Settings is overridden until 'home off'."
        echo "your links and search address: $(firefox_start_dir)/start-links.js (edit it; it is never overwritten)."
        echo "New TABS still show Firefox's own page. To use this page for new tabs too, add-on 'New Tab Override' can point them at the file address above."
      else echo "home page: KURENAI no longer sets it. Firefox keeps the last value in prefs.js: choose your page in Settings > Home (or Restore Defaults)."; fi ;;
    script)
      extra_attached firefox || die "attach first: kurenai-ctl theme extra firefox on"
      p="$(firefox_profile_dir)" || die "Firefox profile not found"
      case "${1:-status}" in
        on)
          if ! firefox_loader_ok "$p"; then
            echo "The script layer needs fx-autoconfig (https://github.com/MrOtherGuy/fx-autoconfig, MPL-2.0), which is not installed in this profile. Nothing was changed."
            echo "Its README says to:"
            echo "  1. copy the repository's program/ contents (config.js and defaults/) into Firefox's folder, usually /usr/lib/firefox  <- a system folder: needs root, you run it"
            echo "  2. copy the repository's profile/ contents (the chrome/ folder) into: $p"
            echo "  3. start Firefox once; if scripts do not load, clear the startup cache (about:support > Clear startup cache)"
            echo "Read that repository's files before you copy anything: its config.js runs with full browser rights. Then run this command again."
            return 1
          fi
          mkdir -p "$p/chrome/JS"; cp "$EXTRAS_DIR/firefox/kurenai.uc.js" "$p/chrome/JS/kurenai.uc.js"
          firefox_program_ok || echo "  note: config.js was not found in /usr/lib/firefox or /usr/lib64/firefox; the script only runs when fx-autoconfig's program files are installed there."
          echo "script layer: installed (chrome/JS/kurenai.uc.js). Restart Firefox. Keys: Ctrl+Alt+H cycles hide states, Ctrl+Alt+V vertical tabs, Ctrl+L again closes the address card. A toolbar button 'Show and hide' is added to the toolbar." ;;
        off) firefox_script_remove "$p"; echo "script layer: removed. Restart Firefox. (The hide state attribute is simply ignored without it.)" ;;
        status) [ -f "$p/chrome/JS/kurenai.uc.js" ] && echo "script layer: installed" || echo "script layer: not installed"
                echo "  fx-autoconfig in the profile: $(firefox_loader_ok "$p" && echo yes || echo no);  program files in the Firefox folder: $(firefox_program_ok && echo yes || echo 'not found')" ;;
        *) die "usage: kurenai-ctl theme extra firefox script on|off|status" ;;
      esac ;;
    *) die "usage: kurenai-ctl theme extra firefox on [--profile DIR] | off | status | script on|off|status | home on|off | profile [DIR]" ;;
  esac
}

# ---- commands -------------------------------------------------------------------------------------------------------------
extra_dests() { local mf="$EXTRAS_DIR/$1/MANIFEST" kind tpl dest style; [ -f "$mf" ] || return 0; while IFS='|' read -r kind tpl dest style; do case "$kind" in ''|\#*) continue;; esac; ex_path "$dest"; echo; done < "$mf"; }
cmd_theme_extras() {
  local act="${1:-status}"; [ $# -gt 0 ] && shift
  case "$act" in
    status)
      echo "app colours (kitty gtk qt btop yazi zathura nvim spicetify firefox)   follow wallpaper changes: $([ "$(theme_get extras_follow 1)" = 1 ] && echo yes || echo no)"
      echo "  colours now: $(theme_enabled && grep -q '"enabled": true' "$THEME_PAL" 2>/dev/null && echo 'from the wallpaper' || echo 'built-in KURENAI colours')"
      local x app state files d n
      for x in $EXTRAS_ALL; do
        case "$x" in gtk) app="gsettings" ;; qt) app="qt6ct" ;; *) app="$x" ;; esac
        state="off"; extra_attached "$x" && state="ATTACHED"
        n=0; files=0; for d in $(extra_dests "$x"); do n=$((n+1)); [ -e "$d" ] && files=$((files+1)); done
        printf '  %-10s %-9s app: %-9s files: %s/%s\n' "$x" "$state" "$(have "$app" && echo found || echo missing)" "$files" "$n"
      done
      [ -f "$EXTRAS_DIR/tokens.awk" ] || echo "  (templates missing in $EXTRAS_DIR: re-run install.sh)"
      ;;
    apply)  theme_extras_apply ;;
    follow) case "${1:-}" in on) theme_set extras_follow 1 ;; off) theme_set extras_follow 0 ;; *) die "usage: kurenai-ctl theme extras follow on|off" ;; esac; echo "app colours follow wallpaper changes: $1" ;;
    reset)  local x; for x in $(extras_list | tr ',' ' '); do cmd_theme_extra "$x" off; done ;;
    *) die "usage: kurenai-ctl theme extras [status|apply|follow on|off|reset]" ;;
  esac
}
cmd_theme_extra() {
  local name="${1:-}" act="${2:-}"
  extra_known "$name" || die "unknown extra '$name'. Available: $EXTRAS_ALL"
  mkdir -p "$STATE/next"
  if [ "$name" = firefox ]; then
    case "$act" in status|script|home|profile) shift 2; cmd_theme_firefox "$act" "$@"; return ;; esac
  fi
  case "$act" in
    on)
      [ -f "$EXTRAS_DIR/tokens.awk" ] && [ -f "$EXTRAS_DIR/$name/MANIFEST" ] || die "templates missing in $EXTRAS_DIR (re-run install.sh)"
      shift 2
      "extra_setup_$name" "$@" || return 1
      extra_attach "$name"
      local tok="$STATE/next/tokens.eff" err
      if ! err="$(extras_make_tokens "$tok" 2>&1)"; then die "colours are not readable enough to apply: $(printf '%s' "$err" | head -n 2 | tr '\n' ';')"; fi
      EX_CHANGED=0; extra_render "$name" "$tok" || return 1
      extra_reload "$name"
      echo "$name: ON ($(theme_enabled && echo 'wallpaper colours' || echo 'built-in KURENAI colours'; ))"
      ;;
    off)
      "extra_teardown_$name"; extra_detach "$name"
      echo "$name: off (your own settings restored, generated files removed)"
      ;;
    *) die "usage: kurenai-ctl theme extra <name> on|off     names: $EXTRAS_ALL   (firefox also: on --profile DIR | status | script on|off|status | home on|off | profile [DIR])" ;;
  esac
}

# ------------------------------------------------------------------ keybind conflicts
cmd_binds_check() {
  local lua="$HYPR_DIR/kurenai-binds.lua"
  [ -f "$lua" ] || die "kurenai-binds.lua is not installed; run install.sh"
  have hyprctl || die "hyprctl not found"

  # Active binds, one per line, tab-separated: modmask  KEY  "dispatcher arg"
  # (parsed from the plain-text output of `hyprctl binds`; Lua-config binds all read "__lua <n>").
  local active
  active="$(hyprctl binds 2>/dev/null | awk '
    function flush() { if (have) printf "%s\t%s\t%s %s\n", m, toupper(k), d, a }
    /^[[:space:]]*modmask:/    { flush(); have=1; m=$2; k=""; d=""; a="" }
    /^[[:space:]]*key:/        { k=$2 }
    /^[[:space:]]*dispatcher:/ { d=$2 }
    /^[[:space:]]*arg:/        { sub(/^[[:space:]]*arg:[[:space:]]*/, ""); a=$0 }
    END { flush() }')"

  if [ -z "$active" ]; then
    echo "Could not read any active binds from 'hyprctl binds' (unexpected output format in Lua mode?)."
    echo "Check by hand:  grep -nE 'SPACE|\"N\"| N ' $HYPR_DIR/*.lua | grep -v kurenai"
    return 1
  fi

  # Once the binds hook is active, KURENAI's own binds are part of `hyprctl binds`. So a chord bound
  # exactly once is KURENAI itself; only a chord bound MORE than once is a clash with something else.
  local own=0
  hook_active "$HYPR_DIR/hyprland.lua" "$MARK_BINDS" && own=1
  if [ "$own" -eq 1 ]; then echo "(The KURENAI binds hook is active, so KURENAI's own binds are expected to show up once each.)"; fi

  local clashes=0 missing=0 chord mask key part n others
  while IFS= read -r chord; do
    mask=0; key=""
    local IFS_SAVE="$IFS"; IFS='+'
    for part in $chord; do
      part="$(printf '%s' "$part" | tr -d ' ' | tr '[:lower:]' '[:upper:]')"
      case "$part" in
        SUPER|MOD4|WIN) mask=$((mask + 64));;
        SHIFT)          mask=$((mask + 1));;
        CTRL|CONTROL)   mask=$((mask + 4));;
        ALT|MOD1)       mask=$((mask + 8));;
        *)              key="$part";;
      esac
    done
    IFS="$IFS_SAVE"
    n="$(printf '%s\n' "$active" | awk -F'\t' -v m="$mask" -v k="$key" '$1==m && $2==k {c++} END{print c+0}')"
    if [ "$own" -eq 1 ]; then
      if   [ "$n" -eq 1 ]; then
        printf '  [ ok  ] %-24s bound once (KURENAI itself)\n' "$chord"
      elif [ "$n" -eq 0 ]; then
        missing=$((missing + 1))
        printf '  [ MISSING ] %-20s not registered although the hook is active (see: hyprctl configerrors)\n' "$chord"
      else
        clashes=$((clashes + 1))
        others="$(printf '%s\n' "$active" | awk -F'\t' -v m="$mask" -v k="$key" '$1==m && $2==k {printf "%s%s", (c++ ? "; " : ""), $3}')"
        printf '  [CLASH] %-24s bound %d times (KURENAI + another bind): %s\n' "$chord" "$n" "$others"
      fi
    else
      if [ "$n" -eq 0 ]; then
        printf '  [ free] %s\n' "$chord"
      else
        clashes=$((clashes + 1))
        others="$(printf '%s\n' "$active" | awk -F'\t' -v m="$mask" -v k="$key" '$1==m && $2==k {printf "%s%s", (c++ ? "; " : ""), $3}')"
        printf '  [CLASH] %-24s already bound to: %s\n' "$chord" "$others"
      fi
    fi
  done < <(grep -oE '^[[:space:]]*\{ "[^"]+"' "$lua" | sed -E 's/^[[:space:]]*\{ "//; s/"$//')

  echo
  if [ "$clashes" -eq 0 ]; then
    if [ "$own" -eq 1 ]; then echo "No clashes: every KURENAI chord is bound exactly once."
    else echo "No clashes found. Safe to run: kurenai-ctl enable-binds"; fi
  else
    echo "$clashes clash(es). Edit the chords in $lua (e.g. change SUPER to SUPER + ALT), then re-run binds-check."
    echo "Lua binds all read '__lua <n>', so they cannot be named from here. Find the other user of a key with:"
    echo "  grep -n -i '<key>' $HYPR_DIR/*.lua"
  fi
  [ "$missing" -gt 0 ] && echo "$missing chord(s) in $lua are not active. Run: hyprctl configerrors   and   hyprctl reload"
  if [ -f "$lua.new" ]; then
    echo "Note: $lua.new exists (a newer shipped binds file). Compare: diff $lua $lua.new"
  fi
  echo "(Parsed from 'hyprctl binds'; if you use submaps or non-standard modifiers, double-check by hand.)"
  echo "Rofi mentions in your hyprland.lua, for reference:"
  grep -n -i rofi "$HYPR_DIR/hyprland.lua" 2>/dev/null | sed 's/^/  /'
  [ "$clashes" -eq 0 ]
}

# ------------------------------------------------------------------ shortcuts page
cmd_shortcuts() {
  local sub="${1:-status}"
  case "$sub" in status|toggle|rescan|open|close) ;; *) die "unknown shortcuts command '$sub' (status | toggle | rescan | open | close)";; esac
  have qs || die "qs not found"
  if ! shell_running; then die "the KURENAI shell is not running (kurenai-ctl start)"; fi
  qs -c kurenai ipc call shortcuts "$sub"
}

# ------------------------------------------------------------------ OSD for brightness keys
# Volume, microphone and media-key OSDs need nothing: the shell watches PipeWire/MPRIS itself.
# Brightness has no event to watch, so the key bind has to tell the shell. This only PRINTS the change.
cmd_media_binds() {
  local f="$HYPR_DIR/hyprland.lua"
  [ -f "$f" ] || die "$f not found"
  local ipc='qs -c kurenai ipc call osd brightness'
  local lines; lines="$(grep 'XF86MonBrightness' "$f" | grep -v '^[[:space:]]*--')"
  if [ -z "$lines" ]; then
    echo "No XF86MonBrightness binds found in $f. Add '&& $ipc' after your brightness command."
    return 0
  fi
  echo "Brightness OSD: append the IPC call to your brightness binds. Nothing has been edited."
  echo "In $f replace:"
  echo
  local line new
  while IFS= read -r line; do
    if printf '%s' "$line" | grep -qF 'osd brightness'; then printf '  (already has the OSD call)  %s\n' "$(printf '%s' "$line" | sed 's/^[[:space:]]*//')"; continue; fi
    new="$(printf '%s' "$line" | sed -E 's/(exec_cmd\("[^"]*)"\)/\1 \&\& '"$ipc"'")/')"
    printf '  - %s\n  + %s\n\n' "$(printf '%s' "$line" | sed 's/^[[:space:]]*//')" "$(printf '%s' "$new" | sed 's/^[[:space:]]*//')"
  done <<< "$lines"
  echo "Then: hyprctl reload"
  echo "(The && makes the OSD appear only after brightnessctl has finished, so it shows the new value.)"
}

# ------------------------------------------------------------------ clipboard history (kurenai-clip)
CLIP_WATCH_PAT='wl-paste .*kurenai-clip store'
clip_helper() {
  local here; here="$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")"
  if [ -x "$here/kurenai-clip" ]; then printf '%s' "$here/kurenai-clip"; else printf '%s' "$HOME/.local/bin/kurenai-clip"; fi
}
clip_watchers() { pgrep -f "$CLIP_WATCH_PAT" 2>/dev/null; }

cmd_clip()        { [ -x "$(clip_helper)" ] || die "kurenai-clip is not installed; run install.sh"; "$(clip_helper)" "$@"; }
cmd_clip_status() {
  echo "recording processes: $(clip_watchers | grep -c .)  (2 while recording: text + images; 0 when paused or off)"
  cmd_clip status
}
# The only "delete everything" path outside the panel: it asks first, and only works at a terminal.
cmd_clip_wipe() {
  [ -t 0 ] || die "this asks for confirmation, so it needs a terminal"
  local a; read -r -p "Delete the WHOLE clipboard history (pinned items are kept)? [y/N] " a
  case "$a" in y|Y|yes|YES) cmd_clip wipe && echo "History deleted." ;; *) echo "Cancelled." ;; esac
}

# ------------------------------------------------------------------ lock screen (kurenai-lock)
LOCK_PAT='(^|/)(qs|quickshell)( .*)? -c kurenai-lock( |$)'
LOCK_LOG_RULES='qt.qpa.wayland.textinput.warning=false'
# the supervisor always runs as "bash <path>/kurenai-lock-supervisor": match exactly that, so an editor or
# `tail` that merely has the name in its arguments is never mistaken for it (or killed)
SUP_PAT='(^|/)bash [^ ]*kurenai-lock-supervisor$'
lock_pids() { pgrep -f "$LOCK_PAT" 2>/dev/null; }
lock_running() { [ -n "$(lock_pids)" ]; }
supervisor_running() { pgrep -f "$SUP_PAT" >/dev/null 2>&1; }
lock_ipc() { qs -c kurenai-lock ipc call lock "$1" 2>/dev/null; }
lock_state() { lock_running && lock_ipc status || true; }
supervisor_path() {
  local here; here="$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")"
  if [ -x "$here/kurenai-lock-supervisor" ]; then printf '%s' "$here/kurenai-lock-supervisor"
  else printf '%s' "$HOME/.local/bin/kurenai-lock-supervisor"; fi
}

cmd_enable_lock()  { hook_add    "lock" "$MARK_LOCK" "$HOOK_LOCK" "kurenai-lock.lua"; }
cmd_disable_lock() { hook_remove "lock" "$MARK_LOCK"; }

cmd_lock() {
  have qs || die "qs not found"
  lock_running || die "the lock process is not running (kurenai-ctl lock-start)"
  lock_ipc lock
}

cmd_lock_status() {
  if lock_running; then echo "locker: running (pid $(lock_pids | tr '\n' ' '))"; else echo "locker: NOT running"; fi
  if supervisor_running; then echo "supervisor: running"; else echo "supervisor: not running"; fi
  local st; st="$(lock_state)"; echo "screen: ${st:-unknown}"
  if [ "$st" = "locked" ] && [ -n "${WAYLAND_DISPLAY:-}" ]; then
    echo "  !! you are typing in your graphical session, so the screen is NOT locked: the locker's state is stale."
    echo "     Fix it with: kurenai-ctl lock-reset"
  fi
  [ -e "${XDG_RUNTIME_DIR:-/tmp}/kurenai-lock.active" ] && echo "re-lock flag: present (a restarted locker would lock again at once)"
  return 0
}

cmd_lock_preview() {
  have qs || die "qs not found"
  local f="$QS_DIR/kurenai-lock/preview.qml"
  [ -f "$f" ] || die "kurenai-lock is not installed; run install.sh"
  echo "Preview: a normal window with the real lock screen. NOTHING is locked."
  echo "Type your password and press Enter: it uses the real PAM check, then the window closes. Ctrl+C to abort."
  qs -p "$f" --log-rules "$LOCK_LOG_RULES"
}

cmd_lock_start() {
  have qs || die "qs not found"
  [ -f "$QS_DIR/kurenai-lock/shell.qml" ] || die "kurenai-lock is not installed; run install.sh"
  [ -n "${WAYLAND_DISPLAY:-}" ] || die "run lock-start in a terminal INSIDE your Hyprland session (from a TTY the locker has no display); from a TTY use: kurenai-ctl lock-recover"
  if lock_running; then echo "lock process is already running."; return 0; fi
  setsid "$(supervisor_path)" >/dev/null 2>&1 < /dev/null &
  sleep 2
  if lock_running; then echo "lock process started."; else echo "it did not start. Look at: qs log -c kurenai-lock   or run: qs -c kurenai-lock"; fi
}

cmd_lock_stop() {
  local st; st="$(lock_state)"
  if [ "$st" = "locked" ]; then
    [ -n "${WAYLAND_DISPLAY:-}" ] && echo "(If you can read this in your normal desktop, the screen is NOT locked and the locker's state is stale: use kurenai-ctl lock-reset.)" >&2
    die "the locker says the screen is locked right now; refusing to stop it."
  fi
  pkill -f "$SUP_PAT" 2>/dev/null                    # first, so it does not restart the locker
  have qs && qs kill -c kurenai-lock >/dev/null 2>&1
  sleep 0.5
  lock_running && pkill -f "$LOCK_PAT" 2>/dev/null
  sleep 0.5
  if lock_running; then echo "could not stop it."; else echo "lock process stopped."; fi
}

# For when the screen is stuck (a grey screen, or Hyprland's placeholder): log in on a text console (Ctrl+Alt+F3),
# run this, then go back (Ctrl+Alt+F1 or F2) and unlock with your password.
#  * a locker that is alive but shows nothing is killed on purpose: the supervisor restarts it and it re-locks
#    (SIGKILL counts as a crash for the supervisor, so it comes back within a second)
#  * if there is no supervisor, one is started inside your Hyprland session
cmd_lock_recover() {
  have hyprctl || die "hyprctl not found"
  if lock_running; then
    echo "Killing the current locker so a fresh one re-locks the screen with a working lock UI..."
    pkill -KILL -f "$LOCK_PAT" 2>/dev/null
    sleep 2
  fi
  if supervisor_running; then
    echo "The supervisor is running: it restarts the locker by itself."
  else
    local sup out; sup="$(supervisor_path)"
    echo "No supervisor: starting one inside your Hyprland session..."
    out="$(hyprctl --instance 0 dispatch "hl.dsp.exec_cmd(\"$sup\")" 2>&1)"
    echo "  hyprctl (Lua form): $out"
    case "$out" in *ok*|*OK*) ;; *)
      out="$(hyprctl --instance 0 dispatch exec "$sup" 2>&1)"
      echo "  hyprctl (classic form): $out" ;;
    esac
    sleep 3
  fi
  echo "locker: $(lock_running && echo running || echo "NOT running")"
  echo "Switch back (Ctrl+Alt+F1 or F2): you should see the lock screen. Type your password."
  echo "Then send me:  kurenai-ctl lock-diagnose"
  echo "Last resort (ends the session, loses unsaved work):  pkill -x Hyprland"
}

# A compact report for troubleshooting. Works from a TTY. Contains no passwords and no notification text.
cmd_lock_diagnose() {
  local run="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  echo "== KURENAI lock diagnostics  $(date '+%F %T')"
  echo "-- processes"
  { pgrep -a -x hypridle; pgrep -a -f "$LOCK_PAT"; pgrep -a -f "$SUP_PAT"; } 2>/dev/null | sed 's/^/  /'
  lock_running || echo "  (locker NOT running)"
  supervisor_running || echo "  (supervisor NOT running)"
  pgrep -x hypridle >/dev/null || echo "  (hypridle NOT running)"
  echo "-- what hypridle's lock_cmd inherits (a lock_cmd without WAYLAND_DISPLAY cannot reach the locker)"
  local pid
  for pid in $(pgrep -x hypridle 2>/dev/null); do
    tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | grep -E '^(WAYLAND_DISPLAY|XDG_RUNTIME_DIR|HYPRLAND_INSTANCE_SIGNATURE)=' | sed "s/^/  [pid $pid] /"
    tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | grep -qE '^WAYLAND_DISPLAY=' || echo "  [pid $pid] WAYLAND_DISPLAY is NOT set in hypridle's environment"
  done
  echo "-- hypridle.conf, lock-related lines"
  grep -nE 'lock_cmd|unlock_cmd|before_sleep_cmd|after_sleep_cmd|on-timeout|on-resume|timeout|ignore_' "$HYPR_DIR/hypridle.conf" 2>/dev/null | sed 's/^/  /' || echo "  (no $HYPR_DIR/hypridle.conf)"
  echo "-- logind sessions"
  local sid
  for sid in $(loginctl list-sessions --no-legend 2>/dev/null | awk -v u="$(id -un)" '$3 == u {print $1}'); do
    loginctl show-session "$sid" -p Id -p Type -p Class -p Active -p State -p LockedHint -p IdleHint 2>/dev/null | tr '\n' ' ' | sed 's/^/  /'; echo
  done
  echo "-- flag and log files"
  ls -l "$run/kurenai-lock.active" 2>&1 | sed 's/^/  /'
  echo "-- IPC (only possible from inside the graphical session)"
  if [ -n "${WAYLAND_DISPLAY:-}" ]; then echo "  screen: $(lock_state)"; else echo "  skipped (no WAYLAND_DISPLAY: you are on a TTY)"; fi
  echo "-- locker log: the last 70 lines of $run/kurenai-lock.log"
  tail -n 70 "$run/kurenai-lock.log" 2>/dev/null | sed 's/^/  /' || true
  [ -f "$run/kurenai-lock.log" ] || echo "  (no log yet: it is written by the supervisor, so start the locker with kurenai-ctl lock-start)"
}

# The locker believes the screen is locked although you are using the desktop (state left over from an unlock
# by an older version). Only meaningful from INSIDE the graphical session: if you can run a command there, the
# screen is not locked. Removes the re-lock flag and restarts the locker with a clean state.
cmd_lock_reset() {
  [ -n "${WAYLAND_DISPLAY:-}" ] || die "run this in a terminal INSIDE your graphical session (if you can type there, the screen is not locked)"
  lock_running || die "the lock process is not running (kurenai-ctl lock-start)"
  echo "Resetting the locker: removing the re-lock flag and restarting it with a clean state..."
  rm -f "${XDG_RUNTIME_DIR:-/tmp}/kurenai-lock.active"
  pkill -KILL -f "$LOCK_PAT" 2>/dev/null
  sleep 2
  if supervisor_running; then sleep 1; else cmd_lock_start; fi
  cmd_lock_status
}

cmd_lock_hypridle() {
  local conf="$HYPR_DIR/hypridle.conf" sample="$HYPR_DIR/hypridle.kurenai.conf"
  have hypridle && echo "hypridle: installed" || echo "hypridle: NOT installed (sudo pacman -S hypridle)"
  echo
  if [ -f "$conf" ]; then
    echo "Your $conf currently has:"
    grep -nE 'lock_cmd|before_sleep_cmd|after_sleep_cmd|timeout|on-timeout' "$conf" | sed 's/^/  /'
    echo
    grep -q 'kurenai-lock' "$conf" && echo "=> it already calls the KURENAI locker." \
      || echo "=> it does NOT call the KURENAI locker yet (e.g. it may call hyprlock). Merge the sample below."
  else
    echo "No $conf yet: copy the sample below to that path."
  fi
  echo
  echo "---- sample ($sample) ----"
  [ -f "$sample" ] && cat "$sample" || echo "(sample not installed; run install.sh)"
  echo "----"
  echo "After editing: restart hypridle (e.g. pkill hypridle; hypridle &  or your usual way)."
  echo "Test: run  loginctl lock-session  and the screen should lock."
}

cmd_lock_sync_theme() {
  local a="$QS_DIR/kurenai/Theme.qml" b="$QS_DIR/kurenai-lock/Theme.qml"
  [ -f "$a" ] && [ -d "$QS_DIR/kurenai-lock" ] || die "both configs must be installed"
  cp "$a" "$b" && echo "Theme copied into the lock config."
  echo "The running locker keeps the old look until restarted: kurenai-ctl lock-stop && kurenai-ctl lock-start"
}

cmd_lock_harden() {
  cat <<'HARDEN'
By default the lock checks your password with a small PAM file inside ~/.config/quickshell/kurenai-lock/pam/.
Any program running as YOU could edit that file (to accept any password) while you are away. A root-owned
PAM service closes that gap. It needs sudo ONCE; nothing here is run for you:

  printf 'auth required pam_unix.so\n'    | sudo tee /etc/pam.d/kurenai-lock
  printf 'auth required pam_fprintd.so\n'  | sudo tee /etc/pam.d/kurenai-lock-fp
  sudo chown root:root /etc/pam.d/kurenai-lock /etc/pam.d/kurenai-lock-fp
  sudo chmod 644 /etc/pam.d/kurenai-lock /etc/pam.d/kurenai-lock-fp

Then, in ~/.config/quickshell/kurenai-lock/Config.qml, set:

  pamDirectory:   "/etc/pam.d"
  pamPassword:    "kurenai-lock"
  pamFingerprint: "kurenai-lock-fp"

and restart the locker (kurenai-ctl lock-stop && kurenai-ctl lock-start).
ALWAYS check it with  kurenai-ctl lock-preview  before relying on it. To go back, set the three values
to "", "password.conf" and "fingerprint.conf".
HARDEN
}

# ------------------------------------------------------------------ rollback / restore
move_aside() {
  local dest="$STATE/removed-$(stamp)"
  mkdir -p "$dest"
  local f
  for f in kurenai.lua kurenai-binds.lua kurenai-autostart.lua kurenai-lock.lua; do
    [ -e "$HYPR_DIR/$f" ] && mv "$HYPR_DIR/$f" "$dest/"
  done
  [ -d "$QS_DIR/kurenai" ] && mv "$QS_DIR/kurenai" "$dest/quickshell-kurenai"
  [ -d "$QS_DIR/kurenai-lock" ] && mv "$QS_DIR/kurenai-lock" "$dest/quickshell-kurenai-lock"
  echo "KURENAI files moved to $dest (nothing deleted)"
  return 0
}

cmd_rollback() {
  [ "$(lock_state)" = "locked" ] && die "the screen is locked right now; unlock it first."
  cmd_lock_stop
  cmd_disable_lock
  cmd_notif_restore
  cmd_disable_autostart
  cmd_disable_binds
  cmd_disable
  move_aside
  reload_hypr
  echo "Rollback complete. Your Rofi, backups and personal files are untouched."
  echo "To go back: re-run install.sh and the enable commands."
}

cmd_restore() {
  local src="$BACKUPS/latest"
  [ -d "$src/hypr" ] || die "no backup at $src (nothing to restore)"
  [ "$(lock_state)" = "locked" ] && die "the screen is locked right now; unlock it first."
  cmd_lock_stop
  cmd_notif_restore
  move_aside
  cp -a "$HYPR_DIR/hyprland.lua" "$HYPR_DIR/hyprland.lua.pre-restore-$(stamp)" 2>/dev/null
  cp -a "$src/hypr/hyprland.lua" "$HYPR_DIR/hyprland.lua" || die "restore of hyprland.lua failed"
  reload_hypr
  echo "hyprland.lua restored from $(readlink -f "$src")."
}

# ------------------------------------------------------------------ validate
PASS=0; WARN=0; FAIL=0
ok()   { printf '  [ ok ] %s\n' "$*"; PASS=$((PASS+1)); }
warn() { printf '  [warn] %s\n' "$*"; WARN=$((WARN+1)); }
bad()  { printf '  [FAIL] %s\n' "$*"; FAIL=$((FAIL+1)); }

cmd_validate() {
  echo "Versions"
  if have hyprctl; then ok "$(hyprctl version 2>/dev/null | head -1)"; else bad "hyprctl not found"; fi
  if have pacman; then
    pacman -Q quickshell >/dev/null 2>&1 && ok "$(pacman -Q quickshell)" || bad "quickshell not installed"
  fi
  have qs && ok "qs binary: $(command -v qs)  ($(qs --version 2>/dev/null | head -1))" || bad "qs not on PATH"

  echo "Files"
  [ -f "$HYPR_DIR/hyprland.lua" ] && ok "hyprland.lua present" || bad "hyprland.lua missing (Lua config required)"
  local f
  for f in kurenai.lua kurenai-binds.lua kurenai-autostart.lua; do
    [ -f "$HYPR_DIR/$f" ] && ok "$f installed" || warn "$f not installed"
  done
  if [ -f "$HYPR_DIR/hyprland.lua" ]; then
    hook_active "$HYPR_DIR/hyprland.lua" "$MARK_THEME" && ok "theme hook active"      || warn "theme hook not active (kurenai-ctl enable)"
    hook_active "$HYPR_DIR/hyprland.lua" "$MARK_BINDS" && ok "binds hook active"      || warn "binds hook not active (kurenai-ctl binds-check, then enable-binds)"
    hook_active "$HYPR_DIR/hyprland.lua" "$MARK_AUTO"  && ok "autostart hook active"  || warn "autostart hook not active (enable only after the shell works)"
  fi
  for f in kurenai-binds.lua kurenai-autostart.lua; do
    [ -f "$HYPR_DIR/$f.new" ] && warn "$f.new is waiting: your $f is older than the shipped one. Compare: diff $HYPR_DIR/$f $HYPR_DIR/$f.new"
  done
  [ -f "$QS_DIR/kurenai/shell.qml" ] && ok "quickshell/kurenai/shell.qml present" || bad "quickshell/kurenai/shell.qml missing"
  [ -f "$QS_DIR/kurenai/qmldir" ]    && ok "qmldir present" || bad "qmldir missing"
  [ -f "$QS_DIR/kurenai/BindParser.js" ] && ok "shortcuts reader (BindParser.js) present" || bad "BindParser.js missing: the shortcuts page needs it (it is not listed in qmldir)"
  if [ -f "$HYPR_DIR/kurenai-binds.lua" ]; then
    grep -q 'shortcuts toggle' "$HYPR_DIR/kurenai-binds.lua" && ok "keybind for the shortcuts page present" \
      || warn "no keybind for the shortcuts page yet: add the SUPER + SLASH line from the README to kurenai-binds.lua (or run: qs -c kurenai ipc call shortcuts toggle)"
  fi
  if [ -f "$QS_DIR/kurenai/qmldir" ]; then
    # every file named in qmldir must exist
    local missing=""
    while read -r a b c d; do
      case "$a" in singleton) file="$d";; "") continue;; *) file="$c";; esac
      [ -f "$QS_DIR/kurenai/$file" ] || missing="$missing $file"
    done < "$QS_DIR/kurenai/qmldir"
    [ -z "$missing" ] && ok "every file listed in qmldir exists" || bad "qmldir lists missing files:$missing"
  fi

  echo "Lua syntax"
  if have luac; then
    for f in kurenai.lua kurenai-binds.lua kurenai-autostart.lua; do
      [ -f "$HYPR_DIR/$f" ] && { luac -p "$HYPR_DIR/$f" 2>/dev/null && ok "$f parses" || bad "$f has a syntax error"; }
    done
  else warn "luac not installed; skipping syntax check (optional)"; fi

  echo "Hyprland config errors"
  if have hyprctl; then
    local errs; errs="$(hyprctl configerrors 2>/dev/null)"
    [ -z "$errs" ] && ok "none reported" || { warn "hyprctl configerrors says:"; printf '%s\n' "$errs" | sed 's/^/         /'; }
  fi

  echo "Services the shell reads"
  systemctl is-active --quiet NetworkManager && ok "NetworkManager active" || warn "NetworkManager not active: network indicator shows 'offline'"
  systemctl --user is-active --quiet pipewire && ok "PipeWire active (user)" || warn "PipeWire not active (user)"
  systemctl --user is-active --quiet wireplumber && ok "WirePlumber active (user)" || warn "WirePlumber not active (user)"
  if have pacman; then pacman -Q upower >/dev/null 2>&1 && ok "upower installed" || warn "upower not installed: battery indicator hidden"; fi

  echo "Notifications"
  local o opid ocomm; o="$(notif_owner)"
  if [ -z "$o" ]; then ok "nobody owns org.freedesktop.Notifications yet (KURENAI can take it)"
  else
    read -r opid ocomm <<< "$o"
    if shell_pids all | grep -qx "$opid"; then
      ok "owned by the KURENAI shell (pid $opid)"
    else
      case "$ocomm" in
        qs|quickshell) warn "owned by a Quickshell process (pid $opid) that is NOT the KURENAI shell; find it: ps -o pid,args -p $opid";;
        *) warn "owned by: $o  -> KURENAI will not receive notifications until it is stopped (kurenai-ctl notif-takeover)";;
      esac
    fi
  fi

  echo "Quick settings (each missing optional tool just hides or explains that control)"
  if have brightnessctl; then
    local bl; bl="$(brightnessctl -m -c backlight 2>/dev/null | head -1 | cut -d, -f1,4)"
    [ -n "$bl" ] && ok "brightnessctl, backlight device: $bl" \
      || warn "brightnessctl installed but no backlight device found (external-only? see: brightnessctl -l)"
  else warn "brightnessctl missing: brightness slider shows an install hint (sudo pacman -S brightnessctl)"; fi
  if systemctl cat power-profiles-daemon.service >/dev/null 2>&1; then
    systemctl is-active --quiet power-profiles-daemon && ok "power-profiles-daemon active" \
      || warn "power-profiles-daemon installed but not running (it is D-Bus activated; check: powerprofilesctl get)"
  else warn "power-profiles-daemon not installed: no power-profile switch (if you use TLP, this is expected)"; fi
  systemctl is-active --quiet bluetooth && ok "bluetooth.service active" \
    || warn "bluetooth.service not active: the Bluetooth section will say there is no adapter"
  local t
  for t in hyprsunset pavucontrol pwvucontrol nm-connection-editor blueman-manager; do
    have "$t" && ok "optional: $t" || printf '  [ -- ] optional, not installed: %s\n' "$t"
  done

  echo "Phase 4 extras (media, OSD, power menu)"
  have playerctl && ok "playerctl installed (your XF86Audio media keys use it)" || warn "playerctl missing: media keybinds that call it do nothing"
  local lk=""; for t in hyprlock swaylock gtklock waylock; do have "$t" && { lk="$t"; break; }; done
  if [ -f "$QS_DIR/kurenai-lock/shell.qml" ]; then
    ok "KURENAI lock screen installed: the power menu's Lock entry uses it while its process runs (see the Lock screen section)"
  elif [ -n "$lk" ]; then
    ok "lock screen: $lk (Lock entry in the power menu)"
  else
    warn "no lock screen installed: the power menu has no Lock entry (run install.sh for the KURENAI lock, or install hyprlock)"
  fi
  have hyprshutdown && ok "hyprshutdown (graceful log out)" || printf '  [ -- ] optional, not installed: hyprshutdown (log out uses Hyprland exit instead)\n'
  local bline ke kn ce cn
  bline="$(grep -h 'XF86MonBrightnessUp' "$HYPR_DIR/hyprland.lua" 2>/dev/null | grep -v '^[[:space:]]*--' | head -1)"
  if [ -n "$bline" ]; then
    ke="$(printf '%s' "$bline" | grep -oE -- '-e[0-9]+' | head -1 | cut -c3-)"
    kn="$(printf '%s' "$bline" | grep -oE -- '-n[0-9]+' | head -1 | cut -c3-)"
    ce="$(grep -oE 'brightnessExponent: *[0-9]+' "$QS_DIR/kurenai/Config.qml" 2>/dev/null | grep -oE '[0-9]+$')"
    cn="$(grep -oE 'brightnessMin: *[0-9]+' "$QS_DIR/kurenai/Config.qml" 2>/dev/null | grep -oE '[0-9]+$')"
    if [ "${ke:-0}" = "${ce:-0}" ] && [ "${kn:-0}" = "${cn:-0}" ]; then ok "brightness curve: keys and shell agree (-e${ke:-0} -n${kn:-0})"
    else warn "brightness keys use -e${ke:-0} -n${kn:-0} but Config.qml has -e${ce:-?} -n${cn:-?}: slider/OSD will disagree with the keys"; fi
    if have udevadm; then ok "udevadm present: brightness changes (Fn keys, brightnessctl) update the slider and OSD live"
    elif printf '%s' "$bline" | grep -qF 'osd brightness'; then ok "no udevadm, but your brightness keys call the OSD (slider updates only while the panel is open)"
    else warn "no udevadm: slider updates only while the panel is open and the brightness OSD needs the key change (kurenai-ctl media-binds)"; fi
  fi
  local nbl; nbl="$(ls /sys/class/backlight 2>/dev/null | wc -l)"
  if [ "$nbl" -gt 1 ]; then
    warn "$nbl backlight devices ($(ls /sys/class/backlight | tr '\n' ' ')): make sure the shell and your keys use the same one; pin it with Config.brightnessDevice"
  fi
  local pb; pb="$(grep -n -E 'exec_cmd\("(poweroff|reboot)"\)' "$HYPR_DIR/hyprland.lua" 2>/dev/null | grep -v '^[0-9]*:[[:space:]]*--')"
  if [ -n "$pb" ]; then
    printf '  [ -- ] note: these keybinds power off / reboot with no confirmation (the KURENAI power menu asks first):\n'
    printf '%s\n' "$pb" | sed 's/^/           /'
  fi

  echo "Lock screen (kurenai-lock)"
  if [ -f "$QS_DIR/kurenai-lock/shell.qml" ]; then
    ok "kurenai-lock installed"
    local pwf="$QS_DIR/kurenai-lock/pam/password.conf"
    grep -q '^auth' "$pwf" 2>/dev/null && ok "PAM password file present" || warn "PAM password file missing/empty: the locker refuses to lock without it"
    [ -e /usr/lib/security/pam_unix.so ] || [ -e /lib/security/pam_unix.so ] && ok "pam_unix module present" || warn "pam_unix.so not found where expected"
    cmp -s "$QS_DIR/kurenai/Theme.qml" "$QS_DIR/kurenai-lock/Theme.qml" && ok "lock theme matches the main theme" \
      || warn "lock theme differs from the main Theme.qml (kurenai-ctl lock-sync-theme)"
    if [ -f "$HYPR_DIR/hyprland.lua" ] && hook_active "$HYPR_DIR/hyprland.lua" "$MARK_LOCK"; then ok "lock hook active (restart-after-crash + autostart)"
    else warn "lock hook not active: the locker will not start with the session (kurenai-ctl enable-lock)"; fi
    grep -qs 'allow_session_lock_restore *= *true' "$HYPR_DIR/kurenai-lock.lua" "$HYPR_DIR/hyprland.lua" \
      && ok "allow_session_lock_restore is set (a crashed locker can be replaced)" \
      || warn "allow_session_lock_restore not set: after a locker crash the screen stays on Hyprland's placeholder until you restart it"
    lock_running && ok "locker running (pid $(lock_pids | head -1))" || warn "locker not running (kurenai-ctl lock-start)"
    supervisor_running && ok "supervisor running (restarts the locker after a crash)" || warn "supervisor not running"
    if lock_running; then
      case "$(lock_state)" in
        unlocked) ok "IPC answers: screen unlocked" ;;
        locked)
          if [ -n "${WAYLAND_DISPLAY:-}" ]; then warn "the locker believes the screen is locked, but you are using the desktop: stale state (kurenai-ctl lock-reset)"
          else ok "screen is currently LOCKED"; fi ;;
        *)        warn "locker running but IPC gives no answer" ;;
      esac
    fi
    if [ -e "${XDG_RUNTIME_DIR:-/tmp}/kurenai-lock.active" ] && [ "$(lock_state)" = "unlocked" ]; then
      warn "stale re-lock flag (${XDG_RUNTIME_DIR:-/tmp}/kurenai-lock.active): a restarted locker would lock at once; remove it if unintended"
    fi
    if have awww; then
      local wp; wp="$(awww query -j 2>/dev/null | grep -o '"image": *"[^"]*"' | head -1)"
      [ -n "$wp" ] && ok "awww reports a wallpaper ($wp)" || warn "awww installed but reports no image (the lock falls back to a generated pattern)"
    else warn "awww not found: the lock uses Config.wallpaper or a generated pattern"; fi
    if have fprintd-list; then
      local fp; fp="$(fprintd-list "$(id -un)" 2>&1)"
      if printf '%s' "$fp" | grep -qi 'finger'; then ok "fingerprint: $(printf '%s' "$fp" | grep -ci 'finger') line(s) from fprintd-list (enrolled fingers shown there)"
      else warn "fprintd installed but no enrolled finger found (fprintd-enroll)"; fi
      [ -e /usr/lib/security/pam_fprintd.so ] && ok "pam_fprintd module present" || warn "pam_fprintd.so missing (fingerprint will be skipped)"
    else warn "fprintd not installed: fingerprint unlock unavailable (sudo pacman -S fprintd)"; fi
    if have hypridle; then
      local hi="$HYPR_DIR/hypridle.conf"
      grep -qs 'kurenai-lock' "$hi" && ok "hypridle calls the KURENAI locker" || warn "hypridle does not call the KURENAI locker yet (kurenai-ctl lock-hypridle)"
    else warn "hypridle not installed: no lock on idle / before sleep"; fi
  else
    warn "kurenai-lock not installed (run install.sh)"
  fi

  echo "Clipboard history and system monitor"
  local miss="" t
  for t in cliphist wl-copy wl-paste; do have "$t" || miss="$miss $t"; done
  [ -z "$miss" ] && ok "cliphist, wl-copy and wl-paste installed" || warn "missing:$miss (sudo pacman -S cliphist wl-clipboard)"
  have xdg-mime && ok "xdg-utils present (lets image entries keep their type)" || warn "xdg-mime missing: install xdg-utils for image entries"
  [ -x "$(clip_helper)" ] && ok "kurenai-clip installed" || warn "kurenai-clip not installed (run install.sh)"
  [ -x "$HOME/.local/bin/kurenai-sysmon" ] || [ -x "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/kurenai-sysmon" ] \
    && ok "kurenai-sysmon installed" || warn "kurenai-sysmon not installed (run install.sh)"
  if grep -qs 'clipboardEnabled: *false' "$QS_DIR/kurenai/Config.qml"; then
    ok "clipboard recording is turned OFF in Config.qml (nothing is recorded)"
  elif [ -x "$(clip_helper)" ]; then
    local nw; nw="$(clip_watchers | grep -c .)"
    local ps; ps="$("$(clip_helper)" paused 2>/dev/null)"
    if [ "$ps" = "yes" ]; then ok "recording is PAUSED (the switch in the clipboard panel)"
    elif ! shell_running; then warn "the shell is not running, so nothing is being recorded"
    elif [ "$nw" -eq 2 ]; then ok "recording: 2 watchers (text + images)"
    elif [ "$nw" -gt 2 ]; then warn "$nw recorders running (expected 2): a stray one from an old session; kurenai-ctl restart clears it"
    else warn "$nw recorders running (expected 2): see: qs log -c kurenai"; fi
    local mode; mode="$(stat -c %a "${XDG_CACHE_HOME:-$HOME/.cache}/cliphist/db" 2>/dev/null || true)"
    if [ -z "$mode" ]; then ok "no cliphist database yet (nothing recorded so far)"
    elif [ "$mode" = "600" ]; then ok "cliphist database is private (mode 600)"
    else warn "cliphist database mode is $mode (should be 600); it is fixed on the next recording, or: chmod 600 ~/.cache/cliphist/db"; fi
    ok "history is deleted after $(grep -oE 'clipboardRetentionDays: *[0-9]+' "$QS_DIR/kurenai/Config.qml" 2>/dev/null | grep -oE '[0-9]+$' || echo 30) days; pinned items are kept"
  fi

  echo "Launcher fallback"
  have rofi && ok "rofi installed: $(command -v rofi)" || warn "rofi not found: the launcher fallback will not work"
  [ -f "$STATE/launcher.json" ] && ok "launcher.json present" || warn "launcher.json missing (the installer creates it)"
  if [ -f "$CFG/rofi/themes/kurenai.rasi" ]; then ok "Rofi theme installed ($CFG/rofi/themes/kurenai.rasi); kurenai-ctl rofi-theme shows how to use it"
  else warn "Rofi theme missing (the installer copies rofi/kurenai.rasi to $CFG/rofi/themes/)"; fi

  echo "Launcher tabs"
  for f in LauncherList LauncherRun LauncherWalls Runner Walls; do
    [ -f "$QS_DIR/kurenai/$f.qml" ] || warn "$f.qml missing from $QS_DIR/kurenai (re-run install.sh)"
  done
  local rh="$STATE/runhistory.json" rhm
  if [ -f "$rh" ]; then
    rhm="$(stat -c %a "$rh" 2>/dev/null || true)"
    [ "$rhm" = "600" ] && ok "Run history is private (mode 600)" || warn "Run history mode is $rhm (should be 600): chmod 600 $rh"
  else ok "no Run history yet (nothing recorded)"; fi
  if have prime-run; then ok "prime-run found: $(command -v prime-run) (Prime tab)"
  else warn "prime-run not found: the Prime tab will say so. On Arch it is in the nvidia-prime package"; fi
  if have awww; then
    ok "awww found (Walls tab)"
    awww query >/dev/null 2>&1 && ok "awww-daemon answers" || warn "awww-daemon is not answering: wallpapers cannot be set until it runs"
  else warn "awww not found: the Walls tab will show thumbnails but cannot set a wallpaper"; fi
  local wd wdirs
  wdirs="$(grep -E 'wallpaperDirs:' "$QS_DIR/kurenai/Config.qml" 2>/dev/null | grep -oE '"[^"]+"' | tr -d '"')"
  [ -n "$wdirs" ] || wdirs='~/Pictures/Wallpapers'
  while IFS= read -r wd; do
    [ -n "$wd" ] || continue
    case "$wd" in "~") wd="$HOME" ;; "~/"*) wd="$HOME/${wd#\~/}" ;; esac
    if [ -d "$wd" ]; then
      ok "wallpaper folder $wd: $(find -L "$wd" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.gif' -o -iname '*.bmp' -o -iname '*.tga' -o -iname '*.tiff' \) 2>/dev/null | wc -l) images (subfolders included)"
    else warn "wallpaper folder $wd does not exist (Config.wallpaperDirs)"; fi
  done <<< "$wdirs"
  echo "Wallpaper colours"
  if have matugen; then ok "matugen found: $(theme_matugen_version)"
  else warn "matugen not found: Quick Settings hides the wallpaper-colours tiles (sudo pacman -S matugen)"; fi
  [ -f "$THEME_TPL/palette.json.tpl" ] && ok "matugen templates installed" || warn "matugen templates missing in $THEME_TPL (re-run install.sh)"
  if [ -s "$THEME_PAL" ]; then ok "palette.json present ($(grep -q '"enabled": true' "$THEME_PAL" && echo 'wallpaper colours in use' || echo 'built-in colours'))"
  else warn "palette.json missing (the installer creates it; kurenai-ctl theme reset recreates it)"; fi
  if theme_enabled; then
    [ -s "$THEME_SRC" ] && ok "colours made from: $(cat "$THEME_SRC")" || warn "wallpaper colours are on but no image has been applied yet (kurenai-ctl theme sync)"
    [ -f "$HYPR_DIR/kurenai-colors.lua" ] && ok "hypr/kurenai-colors.lua present" || warn "hypr/kurenai-colors.lua missing: Hyprland keeps the built-in border colours"
  fi
  have notify-send && ok "notify-send available (for testing)" || warn "notify-send missing (pacman -S libnotify) for testing notifications"

  echo "Fonts"
  fc-list 2>/dev/null | grep -qi "JetBrainsMono Nerd" && ok "JetBrainsMono Nerd Font" || warn "JetBrainsMono Nerd Font missing: icons will be boxes"
  fc-list 2>/dev/null | grep -qi "Adwaita Sans"       && ok "Adwaita Sans" || warn "Adwaita Sans missing: UI falls back to the default font"
  [ -n "$(fc-list :lang=ja family 2>/dev/null | head -1)" ] && ok "a Japanese-capable font is installed" \
    || warn "no Japanese font: decorative kanji will be a box (pacman -S noto-fonts-cjk)"

  echo "Shell"
  local nsh; nsh="$(shell_pids | wc -l)"
  if   [ "$nsh" -eq 0 ]; then warn "KURENAI shell is not running (kurenai-ctl start)"
  elif [ "$nsh" -eq 1 ]; then ok "KURENAI shell is running (pid $(shell_pids))"
  else warn "$nsh KURENAI shells are running (pids: $(shell_pids | tr '\n' ' ')): stacked bars, and the second one cannot register the notification server. Fix: kurenai-ctl restart"
  fi
  pgrep -x waybar >/dev/null && warn "waybar is running: two bars will stack"

  printf '\n%d ok, %d warnings, %d failures\n' "$PASS" "$WARN" "$FAIL"
  [ "$FAIL" -eq 0 ]
}

case "${1:-}" in
  backup)            cmd_backup ;;
  validate)          cmd_validate ;;
  enable)            cmd_enable ;;
  disable)           cmd_disable ;;
  binds-check)       cmd_binds_check ;;
  enable-binds)      cmd_enable_binds ;;
  disable-binds)     cmd_disable_binds ;;
  enable-autostart)  cmd_enable_autostart ;;
  disable-autostart) cmd_disable_autostart ;;
  start)             cmd_start ;;
  stop)              cmd_stop ;;
  restart)           cmd_restart ;;
  logs)              cmd_logs ;;
  debug)             cmd_debug ;;
  media-binds)       cmd_media_binds ;;
  clip)              shift; cmd_clip "$@" ;;
  clip-status)       cmd_clip_status ;;
  clip-wipe)         cmd_clip_wipe ;;
  shortcuts)         shift; cmd_shortcuts "$@" ;;
  enable-lock)       cmd_enable_lock ;;
  disable-lock)      cmd_disable_lock ;;
  lock)              cmd_lock ;;
  lock-status)       cmd_lock_status ;;
  lock-preview)      cmd_lock_preview ;;
  lock-start)        cmd_lock_start ;;
  lock-stop)         cmd_lock_stop ;;
  lock-recover)      cmd_lock_recover ;;
  lock-diagnose)     cmd_lock_diagnose ;;
  lock-reset)        cmd_lock_reset ;;
  lock-hypridle)     cmd_lock_hypridle ;;
  lock-sync-theme)   cmd_lock_sync_theme ;;
  lock-harden)       cmd_lock_harden ;;
  notif-status)      cmd_notif_status ;;
  notif-takeover)    cmd_notif_takeover ;;
  notif-restore)     cmd_notif_restore ;;
  reset-launcher)    cmd_reset_launcher ;;
  rofi-theme)        cmd_rofi_theme ;;
  theme)             shift; cmd_theme "$@" ;;
  theme-apply)       shift; cmd_theme_apply "$@" ;;
  theme-sync)        shift; cmd_theme_sync "$@" ;;
  rollback)          cmd_rollback ;;
  restore)           cmd_restore ;;
  *)                 usage; [ -z "${1:-}" ] || exit 1 ;;
esac
